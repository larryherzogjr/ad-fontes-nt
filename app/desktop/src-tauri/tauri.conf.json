{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ad Fontes NT",
  "version": "1.0.0-rc.7",
  "identifier": "app.ad-fontes.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix .. run desktop:dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix .. run desktop:build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "Ad Fontes NT", "width": 1280, "height": 900, "minWidth": 360, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'self'"
    }
  },
  "bundle": { "active": true, "targets": "all", "createUpdaterArtifacts": true, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "shortDescription": "A New Testament study environment from Ordinary Means." },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5QjdERjNCMzFERjk3QTYKUldTbWw5OHhPOSszYWRyZy9WNDNTNGhYS2lPWVpBb0ZHSUlQRy8xeUNYaVdzU2NKYXJPMUJiWXcK",
      "endpoints": ["https://ad-fontes.app/desktop-updates/stable/latest.json"]
    }
  }
}
