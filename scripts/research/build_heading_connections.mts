/** Separately index explicit publisher-heading references; opening anchors do not infer section/quotation extent. */
import {readFile,writeFile,mkdir} from 'node:fs/promises';import {createHash} from 'node:crypto';
import {books,address,resolveReference} from '../../app/lib/domain/references.ts';
const releaseId='publisher-heading-connections-2026-10-07-v1',pins=`sources/testament-connections/${releaseId}`,out=`app/public/connections/${releaseId}`;
const sha=(b:Buffer|string)=>createHash('sha256').update(b).digest('hex'),encoded=(d:unknown)=>JSON.stringify(d,null,2)+'\n',inputs:Record<string,string>={},connections:any[]=[],excluded:any[]=[];
for(const edition of ['BSB','MSB'])for(const book of books){const ot=book.order<39,sourceRelease=ot?`${edition.toLowerCase()}-ot-2026-10-07-v1`:edition==='BSB'?'bsb-2026-09-05-m2-v1':'msb-2026-09-05-m2-v2';for(let n=1;n<=book.verses.length;n++){const path=`app/public/corpus/${sourceRelease}/${book.code}/${n}.json`,raw=await readFile(path);inputs[path]=sha(raw);const d=JSON.parse(raw.toString());for(let i=0;i<d.blocks.length;i++){const block=d.blocks[i];if(block.role!=='publisher-heading'||block.marker!=='r')continue;let anchor:string|undefined;for(let j=i+1;j<d.blocks.length;j++){if(d.blocks[j].role==='publisher-heading')break;anchor=d.blocks[j].runs.find((r:any)=>r.anchor)?.anchor;if(anchor)break;}if(!anchor){excluded.push({sourceRelease,sourceId:block.sourceId,reason:'No following Scripture opening anchor in this chapter.'});continue;}for(let k=0;k<block.runs.length;k++){const run=block.runs[k];if(!run.marks?.includes('ref'))continue;let targets;try{targets=resolveReference(run.text).filter(r=>(address(r.start).book.order<39)!==ot&&(address(r.end).book.order<39)!==ot);}catch{excluded.push({sourceRelease,sourceId:block.sourceId,reference:run.text,reason:'Explicit heading reference unresolved; no inferred mapping.'});continue;}if(!targets.length)continue;connections.push({id:sha(`${sourceRelease}|${block.sourceId}|${k}`).slice(0,24),kind:'publisher-heading-reference',sourceEdition:edition,sourceRelease,sourceRanges:[{start:anchor,end:anchor}],targetRanges:targets,noteId:`heading:${block.sourceId}`,noteSourceId:block.sourceId,publisherNote:block.runs.map((r:any)=>r.text||'').join(''),originalReference:{loc:run.text,path:`blocks/${i}/runs/${k}`,content:[run.text]},anchorMeaning:'Opening verse following the publisher heading; no section or quotation extent inferred.'});}}}}
const index={schemaVersion:1,releaseId,coverage:'Explicit ref-marked heading runs in pinned BSB/MSB chapters. Opening anchors are navigation aids, not inferred passage extents or editorial classifications.',connections};const manifest={releaseId,implementationSha256:sha(await readFile(new URL(import.meta.url))),inputs,outputSha256:sha(encoded(index)),connections:connections.length,excluded};await mkdir(pins,{recursive:true});const target=`${pins}/manifest.json`;try{if(await readFile(target,'utf8')!==encoded(manifest))throw Error('Pinned heading release changed; create a successor.');}catch(e:any){if(e.code!=='ENOENT')throw e;if(!process.argv.includes('--prepare'))throw Error('New heading release is not pinned');await writeFile(target,encoded(manifest));}await mkdir(out,{recursive:true});await writeFile(`${out}/index.json`,encoded(index));await writeFile(`${out}/manifest.json`,encoded(manifest));console.log(`Verified ${connections.length} explicit publisher-heading connection records.`);
