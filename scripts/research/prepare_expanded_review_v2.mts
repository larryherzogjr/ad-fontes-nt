 inventory.push({id:'connection-review-'+createHash('sha256').update(key).digest('hex').slice(0,16),status:'draft',author:'Codex drafting assistant',kind:selection?'proposed-quotation':'unclassified-publisher-reference',ntRanges,otRanges,proposedNtDisplayRanges:selection?.ranges||null,proposedNtDisplayReference:selection?.reference||null,reviewRequired:'Verify classification, quotation boundaries, mixed-source quotations and interpretive scope. A publisher anchor does not establish quotation extent.',publisherCitations:citations,evidence:await Promise.all([...new Set([...ntRanges.flatMap(expand),...otRanges.flatMap(expand),...(selection?.ranges.flatMap(expand)||[])])].map(verse))});}
