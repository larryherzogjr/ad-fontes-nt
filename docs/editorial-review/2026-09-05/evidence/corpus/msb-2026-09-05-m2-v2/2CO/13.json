  "segments": [
    {
      "id": "2CO.13.1",
      "sourceRef": "2CO.13.1",
      "sourceId": "2CO.usj#content/160/content/1",
      "sourceLabel": "1",
      "anchors": [
        "2CO.13.1"
      ],
      "mappingType": "exact",
      "text": "This is the third time I am coming to you. “Every matter must be established by the testimony of two or three witnesses.”",
      "originalText": "This is the third time I am coming to you. “Every matter must be established by the testimony of two or three witnesses.”",
      "originalStructuredText": "This isthe third time I am coming to you. “Every matter must be established by the testimony of two or three witnesses.”\n ",
      "textSourceId": "msb.txt#line=29048"
    },
    {
      "id": "2CO.13.2",
      "sourceRef": "2CO.13.2",
      "sourceId": "2CO.usj#content/161/content/1",
      "sourceLabel": "2",
      "anchors": [
        "2CO.13.2"
      ],
      "mappingType": "exact",
      "text": "I already warned you the second time I was with you. So now in my absence I write to warn those who sinned earlier and everyone else: If I return, I will not spare anyone,",
      "originalText": "I already warned you the second time I was with you. So now in my absence I write to warn those who sinned earlier and everyone else: If I return, I will not spare anyone,",
      "originalStructuredText": "I already warned you the second time I was with you. So now in my absence I write to warn those who sinned earlier and everyone else: If I return, I will not spare anyone, ",
      "textSourceId": "msb.txt#line=29049"
    },
    {
      "id": "2CO.13.3",
      "sourceRef": "2CO.13.3",
      "sourceId": "2CO.usj#content/161/content/13",
      "sourceLabel": "3",
      "anchors": [
        "2CO.13.3"
      ],
      "mappingType": "exact",
      "text": "since you are demanding proof that Christ is speaking through me. He is not weak in dealing with you, but is powerful among you.",
      "originalText": "since you are demanding proof that Christ is speaking through me. He is not weak in dealing with you, but is powerful among you.",
      "originalStructuredText": "since you are demanding proof that Christ is speaking through me. He is not weak in dealing with you, but is powerful among you. ",
      "textSourceId": "msb.txt#line=29050"
    },
    {
      "id": "2CO.13.4",
      "sourceRef": "2CO.13.4",
      "sourceId": "2CO.usj#content/161/content/17",
      "sourceLabel": "4",
      "anchors": [
        "2CO.13.4"
      ],
      "mappingType": "exact",
      "text": "For although He was indeed crucified in weakness, yet He lives by God’s power. For we are also weak in Him, yet by God’s power we will live with Him concerning you.",
      "originalText": "For although He was indeed crucified in weakness, yet He lives by God’s power. For we are also weak in Him, yet by God’s power we will live with Him concerning you.",
      "originalStructuredText": "For although He was indeed crucified in weakness, yet He lives by God’s power. For we are also weak in Him, yet by God’s power we will live with Him concerning you.\n ",
      "textSourceId": "msb.txt#line=29051"
    },
    {
      "id": "2CO.13.5",
      "sourceRef": "2CO.13.5",
      "sourceId": "2CO.usj#content/162/content/1",
      "sourceLabel": "5",
      "anchors": [
        "2CO.13.5"
      ],
      "mappingType": "exact",
      "text": "Examine yourselves to see whether you are in the faith; test yourselves. Do you not realize that Jesus Christ is in you—unless you actually fail the test?",
      "originalText": "Examine yourselves to see whether you are in the faith; test yourselves. Do you not realize that Jesus Christ is in you—unless you actually fail the test?",
      "originalStructuredText": "Examine yourselves to see whether you are in the faith; test yourselves. Do you not realize that Jesus Christis in you — unless you actually fail the test? ",
      "textSourceId": "msb.txt#line=29052"
    },
    {
      "id": "2CO.13.6",
      "sourceRef": "2CO.13.6",
      "sourceId": "2CO.usj#content/162/content/8",
      "sourceLabel": "6",
      "anchors": [
        "2CO.13.6"
      ],
      "mappingType": "exact",
      "text": "And I hope you will realize that we have not failed the test.",
      "originalText": "And I hope you will realize that we have not failed the test.",
      "originalStructuredText": "And I hope you will realize that we have not failed the test.\n ",
      "textSourceId": "msb.txt#line=29053"
    },
    {
      "id": "2CO.13.7",
      "sourceRef": "2CO.13.7",
      "sourceId": "2CO.usj#content/163/content/1",
      "sourceLabel": "7",
      "anchors": [
        "2CO.13.7"
      ],
      "mappingType": "exact",
      "text": "Now I pray to God that you will not do anything wrong—not that we will appear to have stood the test, but that you will do what is right, even if we appear to have failed.",
      "originalText": "Now I pray to God that you will not do anything wrong—not that we will appear to have stood the test, but that you will do what is right, even if we appear to have failed.",
      "originalStructuredText": "Now I pray to God that you will not do anything wrong — not that we will appear to have stood the test, but that you will do what is right, even if we appear to have failed. ",
      "textSourceId": "msb.txt#line=29054"
    },
    {
      "id": "2CO.13.8",
      "sourceRef": "2CO.13.8",
      "sourceId": "2CO.usj#content/163/content/11",
      "sourceLabel": "8",
      "anchors": [
        "2CO.13.8"
      ],
      "mappingType": "exact",
      "text": "For we cannot do anything against the truth, but only for the truth.",
      "originalText": "For we cannot do anything against the truth, but only for the truth.",
      "originalStructuredText": "For we cannot do anything against the truth, but only for the truth. ",
      "textSourceId": "msb.txt#line=29055"
    },
    {
      "id": "2CO.13.9",
      "sourceRef": "2CO.13.9",
      "sourceId": "2CO.usj#content/163/content/13",
      "sourceLabel": "9",
      "anchors": [
        "2CO.13.9"
      ],
      "mappingType": "exact",
      "text": "In fact, we rejoice when we are weak but you are strong, and our prayer is for your perfection.",
      "originalText": "In fact, we rejoice when we are weak but you are strong, and our prayer is for your perfection.",
      "originalStructuredText": "In fact, we rejoice when we are weak but you are strong, and our prayer is for your perfection.\n ",
      "textSourceId": "msb.txt#line=29056"
    },
    {
      "id": "2CO.13.10",
      "sourceRef": "2CO.13.10",
      "sourceId": "2CO.usj#content/164/content/1",
      "sourceLabel": "10",
      "anchors": [
        "2CO.13.10"
      ],
      "mappingType": "exact",
      "text": "This is why I write these things while absent, so that when I am present I will not need to be severe in my use of the authority that the Lord gave me for building you up, not for tearing you down.",
      "originalText": "This is why I write these things while absent, so that when I am present I will not need to be severe in my use of the authority that the Lord gave me for building you up, not for tearing you down.",
      "originalStructuredText": "This is why I write these things while absent, so that when I am present I will not need to be severe in my use of the authority that the Lord gave me for building you up, not for tearing you down.\n ",
      "textSourceId": "msb.txt#line=29057"
    },
    {
      "id": "2CO.13.11",
      "sourceRef": "2CO.13.11",
      "sourceId": "2CO.usj#content/166/content/1",
      "sourceLabel": "11",
      "anchors": [
        "2CO.13.11"
      ],
      "mappingType": "exact",
      "text": "Finally, brothers, rejoice! Aim for perfect harmony, encourage one another, be of one mind, live in peace. And the God of love and peace will be with you.",
      "originalText": "Finally, brothers, rejoice! Aim for perfect harmony, encourage one another, be of one mind, live in peace. And the God of love and peace will be with you.",
      "originalStructuredText": "Finally, brothers, rejoice! Aim for perfect harmony, encourage one another,be of one mind, live in peace. And the God of love and peace will be with you.\n ",
      "textSourceId": "msb.txt#line=29058"
    },
    {
      "id": "2CO.13.12",
      "sourceRef": "2CO.13.12",
      "sourceId": "2CO.usj#content/167/content/1",
      "sourceLabel": "12",
      "anchors": [
        "2CO.13.12"
      ],
      "mappingType": "exact",
      "text": "Greet one another with a holy kiss.",
      "originalText": "Greet one another with a holy kiss.",
      "originalStructuredText": "Greet one another with a holy kiss.\n ",
      "textSourceId": "msb.txt#line=29059"
    },
    {
      "id": "2CO.13.13",
      "sourceRef": "2CO.13.13",
      "sourceId": "2CO.usj#content/168/content/1",
      "sourceLabel": "13",
      "anchors": [
        "2CO.13.13"
      ],
      "mappingType": "exact",
      "text": "All the saints send you greetings.",
      "originalText": "All the saints send you greetings.",
      "originalStructuredText": "All the saints send you greetings.\n ",
      "textSourceId": "msb.txt#line=29060"
    },
    {
      "id": "2CO.13.14",
      "sourceRef": "2CO.13.14",
      "sourceId": "2CO.usj#content/169/content/1",
      "sourceLabel": "14",
      "anchors": [
        "2CO.13.14"
      ],
      "mappingType": "exact",
      "text": "The grace of the Lord Jesus Christ, and the love of God, and the fellowship of the Holy Spirit be with all of you. Amen.",
      "originalText": "The grace of the Lord Jesus Christ, and the love of God, and the fellowship of the Holy Spirit be with all of you. Amen.",
      "originalStructuredText": "The grace of the Lord Jesus Christ, and the love of God, and the fellowship of the Holy Spirit be with all of you. Amen.",
      "textSourceId": "msb.txt#line=29061"
    }
  ],
