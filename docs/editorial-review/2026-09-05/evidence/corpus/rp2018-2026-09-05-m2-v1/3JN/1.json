    {
      "marker": "p",
      "role": "scripture",
      "sourceId": "csv-unicode/ccat/no-variants/3JO.csv#row=10",
      "runs": [
        {
          "verse": "9",
          "anchor": "3JN.1.9",
          "anchors": [
            "3JN.1.9"
          ],
          "sourceAnchor": "3JN.1.9"
        },
        {
          "text": "Ἔγραψα τῇ ἐκκλησίᾳ· ἀλλ’ ὁ φιλοπρωτεύων αὐτῶν Διοτρεφὴς οὐκ ἐπιδέχεται ἡμᾶς.",
          "anchor": "3JN.1.9",
          "marks": [],
          "anchors": [
            "3JN.1.9"
          ],
          "sourceAnchor": "3JN.1.9"
        },
        {
          "text": " ",
          "anchor": "3JN.1.9",
          "marks": [],
          "anchors": [
            "3JN.1.9"
          ],
          "sourceAnchor": "3JN.1.9"
        },
        {
          "verse": "10",
          "anchor": "3JN.1.10",
          "anchors": [
            "3JN.1.10"
          ],
          "sourceAnchor": "3JN.1.10"
        },
        {
          "text": "Διὰ τοῦτο, ἐὰν ἔλθω, ὑπομνήσω αὐτοῦ τὰ ἔργα ἃ ποιεῖ, λόγοις πονηροῖς φλυαρῶν ἡμᾶς· καὶ μὴ ἀρκούμενος ἐπὶ τούτοις, οὔτε αὐτὸς ἐπιδέχεται τοὺς ἀδελφούς, καὶ τοὺς βουλομένους κωλύει, καὶ ἐκ τῆς ἐκκλησίας ἐκβάλλει.",
          "anchor": "3JN.1.10",
          "marks": [],
          "anchors": [
            "3JN.1.10"
          ],
          "sourceAnchor": "3JN.1.10"
        },
        {
          "text": " ",
          "anchor": "3JN.1.10",
          "marks": [],
          "anchors": [
            "3JN.1.10"
          ],
          "sourceAnchor": "3JN.1.10"
        },
        {
          "verse": "11",
          "anchor": "3JN.1.11",
          "anchors": [
            "3JN.1.11"
          ],
          "sourceAnchor": "3JN.1.11"
        },
        {
          "text": "Ἀγαπητέ, μὴ μιμοῦ τὸ κακόν, ἀλλὰ τὸ ἀγαθόν. Ὁ ἀγαθοποιῶν ἐκ τοῦ θεοῦ ἐστίν· ὁ κακοποιῶν οὐχ ἑώρακεν τὸν θεόν.",
          "anchor": "3JN.1.11",
          "marks": [],
          "anchors": [
            "3JN.1.11"
          ],
          "sourceAnchor": "3JN.1.11"
        },
        {
          "text": " ",
          "anchor": "3JN.1.11",
          "marks": [],
          "anchors": [
            "3JN.1.11"
          ],
          "sourceAnchor": "3JN.1.11"
        },
        {
          "verse": "12",
          "anchor": "3JN.1.12",
          "anchors": [
            "3JN.1.12"
          ],
          "sourceAnchor": "3JN.1.12"
        },
        {
          "text": "Δημητρίῳ μεμαρτύρηται ὑπὸ πάντων, καὶ ὑπ’ αὐτῆς τῆς ἀληθείας· καὶ ἡμεῖς δὲ μαρτυροῦμεν, καὶ οἴδατε ὅτι ἡ μαρτυρία ἡμῶν ἀληθής ἐστιν.",
          "anchor": "3JN.1.12",
          "marks": [],
          "anchors": [
            "3JN.1.12"
          ],
          "sourceAnchor": "3JN.1.12"
        },
        {
          "text": " ",
          "anchor": "3JN.1.12",
          "marks": [],
          "anchors": [
            "3JN.1.12"
          ],
          "sourceAnchor": "3JN.1.12"
        }
      ]
    },
    {
      "marker": "p",
      "role": "scripture",
      "sourceId": "csv-unicode/ccat/no-variants/3JO.csv#row=14",
