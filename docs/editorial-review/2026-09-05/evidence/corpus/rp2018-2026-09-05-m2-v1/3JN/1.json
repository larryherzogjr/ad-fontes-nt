          "anchor": "3JN.1.3",
          "marks": [],
          "anchors": [
            "3JN.1.3"
          ],
          "sourceAnchor": "3JN.1.3"
        },
        {
          "verse": "4",
          "anchor": "3JN.1.4",
          "anchors": [
            "3JN.1.4"
          ],
          "sourceAnchor": "3JN.1.4"
        },
        {
          "text": "Μειζοτέραν τούτων οὐκ ἔχω χαράν, ἵνα ἀκούω τὰ ἐμὰ τέκνα ἐν ἀληθείᾳ περιπατοῦντα.",
          "anchor": "3JN.1.4",
          "marks": [],
          "anchors": [
            "3JN.1.4"
          ],
          "sourceAnchor": "3JN.1.4"
        },
