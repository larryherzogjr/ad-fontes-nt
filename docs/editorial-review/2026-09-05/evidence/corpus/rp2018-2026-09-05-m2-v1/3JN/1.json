          "sourceAnchor": "3JN.1.4"
        }
      ]
    },
    {
      "marker": "p",
      "role": "scripture",
      "sourceId": "csv-unicode/ccat/no-variants/3JO.csv#row=6",
      "runs": [
        {
          "verse": "5",
          "anchor": "3JN.1.5",
          "anchors": [
            "3JN.1.5"
          ],
          "sourceAnchor": "3JN.1.5"
        },
        {
          "text": "Ἀγαπητέ, πιστὸν ποιεῖς ὃ ἐὰν ἐργάσῃ εἰς τοὺς ἀδελφοὺς καὶ εἰς τοὺς ξένους,",
          "anchor": "3JN.1.5",
          "marks": [],
          "anchors": [
            "3JN.1.5"
          ],
          "sourceAnchor": "3JN.1.5"
        },
        {
          "text": " ",
          "anchor": "3JN.1.5",
          "marks": [],
          "anchors": [
            "3JN.1.5"
          ],
          "sourceAnchor": "3JN.1.5"
        },
        {
          "verse": "6",
          "anchor": "3JN.1.6",
          "anchors": [
            "3JN.1.6"
          ],
          "sourceAnchor": "3JN.1.6"
        },
        {
          "text": "οἳ ἐμαρτύρησάν σου τῇ ἀγάπῃ ἐνώπιον ἐκκλησίας· οὓς καλῶς ποιήσεις προπέμψας ἀξίως τοῦ θεοῦ.",
          "anchor": "3JN.1.6",
          "marks": [],
          "anchors": [
            "3JN.1.6"
          ],
          "sourceAnchor": "3JN.1.6"
        },
        {
          "text": " ",
          "anchor": "3JN.1.6",
          "marks": [],
          "anchors": [
            "3JN.1.6"
          ],
          "sourceAnchor": "3JN.1.6"
        },
        {
          "verse": "7",
          "anchor": "3JN.1.7",
          "anchors": [
            "3JN.1.7"
          ],
          "sourceAnchor": "3JN.1.7"
        },
        {
          "text": "Ὑπὲρ γὰρ τοῦ ὀνόματος ἐξῆλθον μηδὲν λαμβάνοντες ἀπὸ τῶν ἐθνῶν.",
          "anchor": "3JN.1.7",
          "marks": [],
          "anchors": [
            "3JN.1.7"
          ],
          "sourceAnchor": "3JN.1.7"
        },
        {
          "text": " ",
          "anchor": "3JN.1.7",
          "marks": [],
          "anchors": [
            "3JN.1.7"
          ],
          "sourceAnchor": "3JN.1.7"
        },
        {
          "verse": "8",
          "anchor": "3JN.1.8",
          "anchors": [
            "3JN.1.8"
          ],
          "sourceAnchor": "3JN.1.8"
        },
        {
          "text": "Ἡμεῖς οὖν ὀφείλομεν ἀπολαμβάνειν τοὺς τοιούτους, ἵνα συνεργοὶ γινώμεθα τῇ ἀληθείᾳ.",
          "anchor": "3JN.1.8",
          "marks": [],
          "anchors": [
            "3JN.1.8"
          ],
          "sourceAnchor": "3JN.1.8"
        },
        {
          "text": " ",
          "anchor": "3JN.1.8",
          "marks": [],
          "anchors": [
