          "anchors": [
            "2CO.13.13"
          ],
          "sourceAnchor": "2CO.13.13"
        },
        {
          "text": "Ἀσπάζονται ὑμᾶς οἱ ἅγιοι πάντες.",
          "anchor": "2CO.13.13",
          "marks": [],
          "anchors": [
            "2CO.13.13"
          ],
          "sourceAnchor": "2CO.13.13"
