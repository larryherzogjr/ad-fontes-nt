          ],
          "sourceAnchor": "2CO.13.11"
        },
        {
          "verse": "12",
          "anchor": "2CO.13.12",
          "anchors": [
            "2CO.13.12"
          ],
          "sourceAnchor": "2CO.13.12"
        },
        {
          "text": "Ἀσπάσασθε ἀλλήλους ἐν ἁγίῳ φιλήματι.",
          "anchor": "2CO.13.12",
          "marks": [],
          "anchors": [
            "2CO.13.12"
          ],
          "sourceAnchor": "2CO.13.12"
        },
        {
