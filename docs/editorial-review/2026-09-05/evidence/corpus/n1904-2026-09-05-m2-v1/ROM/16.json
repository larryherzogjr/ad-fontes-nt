{
  "book": "ROM",
  "chapter": 16,
  "blocks": [
    {
      "marker": "p",
      "role": "scripture",
      "sourceId": "xhtml/Romans-ap.xhtml#body/141",
      "runs": [
        {
          "text": " ",
          "anchor": null,
          "marks": []
        },
        {
          "verse": "1",
          "anchor": "ROM.16.1",
          "anchors": [
            "ROM.16.1"
          ],
          "sourceAnchor": "ROM.16.1"
        },
        {
          "text": " Συνίστημι δὲ\n  ὑμῖν Φοίβην τὴν ἀδελφὴν ἡμῶν, οὖσαν διάκονον τῆς ἐκκλησίας τῆς ἐν\n  Κενχρεαῖς, ",
          "anchor": "ROM.16.1",
          "marks": [],
          "anchors": [
            "ROM.16.1"
          ],
          "sourceAnchor": "ROM.16.1"
        },
        {
          "verse": "2",
          "anchor": "ROM.16.2",
          "anchors": [
            "ROM.16.2"
          ],
          "sourceAnchor": "ROM.16.2"
        },
        {
          "text": " ἵνα αὐτὴν προσδέξησθε ἐν\n  Κυρίῳ ἀξίως τῶν ἁγίων, καὶ παραστῆτε αὐτῇ ἐν ᾧ ἂν ὑμῶν χρῄζῃ\n  πράγματι· καὶ γὰρ αὐτὴ προστάτις πολλῶν ἐγενήθη καὶ ἐμοῦ\n  αὐτοῦ.",
          "anchor": "ROM.16.2",
          "marks": [],
          "anchors": [
            "ROM.16.2"
          ],
          "sourceAnchor": "ROM.16.2"
        }
      ]
    },
    {
      "marker": "p",
      "role": "scripture",
      "sourceId": "xhtml/Romans-ap.xhtml#body/142",
      "runs": [
        {
          "text": " ",
          "anchor": "ROM.16.2",
          "marks": [],
          "anchors": [
            "ROM.16.2"
          ],
          "sourceAnchor": "ROM.16.2"
        },
        {
          "verse": "3",
          "anchor": "ROM.16.3",
          "anchors": [
            "ROM.16.3"
          ],
          "sourceAnchor": "ROM.16.3"
        },
        {
          "text": " Ἀσπάσασθε\n  Πρίσκαν καὶ Ἀκύλαν τοὺς συνεργούς μου ἐν Χριστῷ Ἰησοῦ,\n  ",
          "anchor": "ROM.16.3",
          "marks": [],
          "anchors": [
            "ROM.16.3"
          ],
          "sourceAnchor": "ROM.16.3"
        },
        {
          "verse": "4",
          "anchor": "ROM.16.4",
          "anchors": [
            "ROM.16.4"
          ],
          "sourceAnchor": "ROM.16.4"
        },
        {
          "text": " οἵτινες ὑπὲρ τῆς ψυχῆς μου τὸν ἑαυτῶν\n  τράχηλον ὑπέθηκαν, οἷς οὐκ ἐγὼ μόνος εὐχαριστῶ ἀλλὰ καὶ πᾶσαι αἱ\n  ἐκκλησίαι τῶν ἐθνῶν, ",
          "anchor": "ROM.16.4",
          "marks": [],
          "anchors": [
            "ROM.16.4"
          ],
          "sourceAnchor": "ROM.16.4"
        },
        {
          "verse": "5",
          "anchor": "ROM.16.5",
          "anchors": [
            "ROM.16.5"
          ],
          "sourceAnchor": "ROM.16.5"
        },
        {
          "text": " καὶ τὴν κατ’ οἶκον\n  αὐτῶν ἐκκλησίαν. ἀσπάσασθε Ἐπαίνετον τὸν ἀγαπητόν μου, ὅς ἐστιν\n  ἀπαρχὴ τῆς Ἀσίας εἰς Χριστόν. ",
          "anchor": "ROM.16.5",
          "marks": [],
          "anchors": [
            "ROM.16.5"
          ],
          "sourceAnchor": "ROM.16.5"
        },
        {
          "verse": "6",
          "anchor": "ROM.16.6",
          "anchors": [
            "ROM.16.6"
          ],
          "sourceAnchor": "ROM.16.6"
        },
        {
          "text": " ἀσπάσασθε\n  Μαριάν, ἥτις πολλὰ ἐκοπίασεν εἰς ὑμᾶς. ",
          "anchor": "ROM.16.6",
          "marks": [],
          "anchors": [
            "ROM.16.6"
          ],
          "sourceAnchor": "ROM.16.6"
        },
        {
          "verse": "7",
          "anchor": "ROM.16.7",
          "anchors": [
            "ROM.16.7"
          ],
          "sourceAnchor": "ROM.16.7"
        },
        {
          "text": "\n  ἀσπάσασθε Ἀνδρόνικον καὶ Ἰουνίαν τοὺς συγγενεῖς μου καὶ\n  συναιχμαλώτους μου, οἵτινές εἰσιν ἐπίσημοι ἐν τοῖς ἀποστόλοις, οἳ\n  καὶ πρὸ ἐμοῦ γέγοναν ἐν Χριστῷ. ",
          "anchor": "ROM.16.7",
          "marks": [],
          "anchors": [
            "ROM.16.7"
          ],
          "sourceAnchor": "ROM.16.7"
        },
        {
          "verse": "8",
          "anchor": "ROM.16.8",
          "anchors": [
            "ROM.16.8"
          ],
          "sourceAnchor": "ROM.16.8"
        },
        {
          "text": "\n  ἀσπάσασθε Ἀμπλιᾶτον τὸν ἀγαπητόν μου ἐν Κυρίῳ. ",
          "anchor": "ROM.16.8",
          "marks": [],
          "anchors": [
            "ROM.16.8"
          ],
          "sourceAnchor": "ROM.16.8"
        },
        {
          "verse": "9",
          "anchor": "ROM.16.9",
          "anchors": [
            "ROM.16.9"
          ],
          "sourceAnchor": "ROM.16.9"
        },
        {
          "text": " ἀσπάσασθε Οὐρβανὸν τὸν συνεργὸν ἡμῶν ἐν Χριστῷ καὶ\n  Στάχυν τὸν ἀγαπητόν μου. ",
          "anchor": "ROM.16.9",
          "marks": [],
          "anchors": [
            "ROM.16.9"
          ],
          "sourceAnchor": "ROM.16.9"
        },
        {
          "verse": "10",
          "anchor": "ROM.16.10",
          "anchors": [
            "ROM.16.10"
          ],
          "sourceAnchor": "ROM.16.10"
        },
        {
          "text": " ἀσπάσασθε\n  Ἀπελλῆν τὸν δόκιμον ἐν Χριστῷ. ἀσπάσασθε τοὺς ἐκ τῶν\n  Ἀριστοβούλου. ",
          "anchor": "ROM.16.10",
          "marks": [],
          "anchors": [
            "ROM.16.10"
          ],
          "sourceAnchor": "ROM.16.10"
        },
        {
          "verse": "11",
          "anchor": "ROM.16.11",
          "anchors": [
            "ROM.16.11"
          ],
          "sourceAnchor": "ROM.16.11"
        },
        {
          "text": " ἀσπάσασθε Ἡρῳδίωνα τὸν\n  συγγενῆ μου. ἀσπάσασθε τοὺς ἐκ τῶν Ναρκίσσου τοὺς ὄντας ἐν Κυρίῳ.\n  ",
          "anchor": "ROM.16.11",
          "marks": [],
          "anchors": [
            "ROM.16.11"
          ],
          "sourceAnchor": "ROM.16.11"
        },
        {
          "verse": "12",
          "anchor": "ROM.16.12",
          "anchors": [
            "ROM.16.12"
          ],
          "sourceAnchor": "ROM.16.12"
        },
        {
          "text": " ἀσπάσασθε Τρύφαιναν καὶ Τρυφῶσαν τὰς\n  κοπιώσας ἐν Κυρίῳ. ἀσπάσασθε Περσίδα τὴν ἀγαπητήν, ἥτις πολλὰ\n  ἐκοπίασεν ἐν Κυρίῳ. ",
          "anchor": "ROM.16.12",
          "marks": [],
          "anchors": [
            "ROM.16.12"
          ],
          "sourceAnchor": "ROM.16.12"
        },
        {
          "verse": "13",
          "anchor": "ROM.16.13",
          "anchors": [
            "ROM.16.13"
          ],
          "sourceAnchor": "ROM.16.13"
        },
        {
          "text": " ἀσπάσασθε Ῥοῦφον\n  τὸν ἐκλεκτὸν ἐν Κυρίῳ καὶ τὴν μητέρα αὐτοῦ καὶ ἐμοῦ. ",
          "anchor": "ROM.16.13",
          "marks": [],
          "anchors": [
            "ROM.16.13"
          ],
          "sourceAnchor": "ROM.16.13"
        },
        {
          "verse": "14",
          "anchor": "ROM.16.14",
          "anchors": [
            "ROM.16.14"
          ],
          "sourceAnchor": "ROM.16.14"
        },
        {
          "text": " ἀσπάσασθε Ἀσύνκριτον, Φλέγοντα, Ἑρμῆν, Πατρόβαν,\n  Ἑρμᾶν, καὶ τοὺς σὺν αὐτοῖς ἀδελφούς. ",
          "anchor": "ROM.16.14",
          "marks": [],
          "anchors": [
            "ROM.16.14"
          ],
          "sourceAnchor": "ROM.16.14"
        },
        {
          "verse": "15",
          "anchor": "ROM.16.15",
          "anchors": [
            "ROM.16.15"
          ],
          "sourceAnchor": "ROM.16.15"
        },
        {
          "text": "\n  ἀσπάσασθε Φιλόλογον καὶ Ἰουλίαν, Νηρέα καὶ τὴν ἀδελφὴν αὐτοῦ, καὶ\n  Ὀλυμπᾶν, καὶ τοὺς σὺν αὐτοῖς πάντας ἁγίους. ",
          "anchor": "ROM.16.15",
          "marks": [],
          "anchors": [
            "ROM.16.15"
          ],
          "sourceAnchor": "ROM.16.15"
        },
        {
          "verse": "16",
          "anchor": "ROM.16.16",
          "anchors": [
            "ROM.16.16"
          ],
          "sourceAnchor": "ROM.16.16"
        },
        {
          "text": " ἀσπάσασθε ἀλλήλους ἐν φιλήματι ἁγίῳ. ἀσπάζονται\n  ὑμᾶς αἱ ἐκκλησίαι πᾶσαι τοῦ Χριστοῦ.",
          "anchor": "ROM.16.16",
          "marks": [],
          "anchors": [
            "ROM.16.16"
          ],
          "sourceAnchor": "ROM.16.16"
        }
      ]
    },
    {
      "marker": "p",
      "role": "scripture",
      "sourceId": "xhtml/Romans-ap.xhtml#body/143",
      "runs": [
        {
          "text": " ",
          "anchor": "ROM.16.16",
          "marks": [],
          "anchors": [
            "ROM.16.16"
          ],
          "sourceAnchor": "ROM.16.16"
        },
        {
          "verse": "17",
          "anchor": "ROM.16.17",
          "anchors": [
            "ROM.16.17"
          ],
          "sourceAnchor": "ROM.16.17"
        },
        {
          "text": " Παρακαλῶ δὲ\n  ὑμᾶς, ἀδελφοί, σκοπεῖν τοὺς τὰς διχοστασίας καὶ τὰ σκάνδαλα παρὰ\n  τὴν διδαχὴν ἣν ὑμεῖς ἐμάθετε ποιοῦντας, καὶ ἐκκλίνετε ἀπ’ αὐτῶν·\n  ",
          "anchor": "ROM.16.17",
          "marks": [],
          "anchors": [
            "ROM.16.17"
          ],
          "sourceAnchor": "ROM.16.17"
        },
        {
          "verse": "18",
          "anchor": "ROM.16.18",
          "anchors": [
            "ROM.16.18"
          ],
          "sourceAnchor": "ROM.16.18"
        },
        {
          "text": " οἱ γὰρ τοιοῦτοι τῷ Κυρίῳ ἡμῶν Χριστῷ\n  οὐ δουλεύουσιν ἀλλὰ τῇ ἑαυτῶν κοιλίᾳ, καὶ διὰ τῆς χρηστολογίας\n  καὶ εὐλογίας ἐξαπατῶσιν τὰς καρδίας τῶν ἀκάκων. ",
          "anchor": "ROM.16.18",
          "marks": [],
          "anchors": [
            "ROM.16.18"
          ],
          "sourceAnchor": "ROM.16.18"
        },
        {
          "verse": "19",
          "anchor": "ROM.16.19",
          "anchors": [
            "ROM.16.19"
          ],
          "sourceAnchor": "ROM.16.19"
        },
        {
          "text": " ἡ γὰρ ὑμῶν ὑπακοὴ εἰς πάντας ἀφίκετο· ἐφ’ ὑμῖν οὖν\n  χαίρω, θέλω δὲ ὑμᾶς σοφοὺς εἶναι εἰς τὸ ἀγαθόν, ἀκεραίους δὲ εἰς\n  τὸ κακόν. ",
          "anchor": "ROM.16.19",
          "marks": [],
          "anchors": [
            "ROM.16.19"
          ],
          "sourceAnchor": "ROM.16.19"
        },
        {
          "verse": "20",
          "anchor": "ROM.16.20",
          "anchors": [
            "ROM.16.20"
          ],
          "sourceAnchor": "ROM.16.20"
        },
        {
          "text": " ὁ δὲ Θεὸς τῆς εἰρήνης\n  συντρίψει τὸν Σατανᾶν ὑπὸ τοὺς πόδας ὑμῶν ἐν τάχει.",
          "anchor": "ROM.16.20",
          "marks": [],
          "anchors": [
            "ROM.16.20"
          ],
          "sourceAnchor": "ROM.16.20"
        }
      ]
    },
    {
      "marker": "p",
      "role": "scripture",
      "sourceId": "xhtml/Romans-ap.xhtml#body/144",
      "runs": [
        {
          "text": " Ἡ χάρις τοῦ Κυρίου ἡμῶν Ἰησοῦ μεθ’\n  ὑμῶν.",
          "anchor": "ROM.16.20",
          "marks": [],
          "anchors": [
            "ROM.16.20"
          ],
          "sourceAnchor": "ROM.16.20"
        }
      ]
    },
    {
      "marker": "p",
      "role": "scripture",
      "sourceId": "xhtml/Romans-ap.xhtml#body/145",
      "runs": [
        {
          "text": " ",
          "anchor": "ROM.16.20",
          "marks": [],
          "anchors": [
            "ROM.16.20"
          ],
          "sourceAnchor": "ROM.16.20"
        },
        {
          "verse": "21",
          "anchor": "ROM.16.21",
          "anchors": [
            "ROM.16.21"
          ],
          "sourceAnchor": "ROM.16.21"
        },
        {
          "text": " Ἀσπάζεται\n  ὑμᾶς Τιμόθεος ὁ συνεργός μου, καὶ Λούκιος καὶ Ἰάσων καὶ\n  Σωσίπατρος οἱ συγγενεῖς μου. ",
          "anchor": "ROM.16.21",
          "marks": [],
          "anchors": [
            "ROM.16.21"
          ],
          "sourceAnchor": "ROM.16.21"
        },
        {
          "verse": "22",
          "anchor": "ROM.16.22",
          "anchors": [
            "ROM.16.22"
          ],
          "sourceAnchor": "ROM.16.22"
        },
        {
          "text": " ἀσπάζομαι\n  ὑμᾶς ἐγὼ Τέρτιος ὁ γράψας τὴν ἐπιστολὴν ἐν Κυρίῳ. ",
          "anchor": "ROM.16.22",
          "marks": [],
          "anchors": [
            "ROM.16.22"
          ],
          "sourceAnchor": "ROM.16.22"
        },
        {
          "verse": "23",
          "anchor": "ROM.16.23",
          "anchors": [
            "ROM.16.23"
          ],
          "sourceAnchor": "ROM.16.23"
        },
        {
          "text": " ἀσπάζεται ὑμᾶς Γάϊος ὁ ξένος μου καὶ ὅλης τῆς\n  ἐκκλησίας. ἀσπάζεται ὑμᾶς Ἔραστος ὁ οἰκονόμος τῆς πόλεως καὶ\n  Κούαρτος ὁ ἀδελφός.",
          "anchor": "ROM.16.23",
          "marks": [],
          "anchors": [
            "ROM.16.23"
          ],
          "sourceAnchor": "ROM.16.23"
        }
      ]
    },
    {
      "marker": "p",
      "role": "scripture",
      "sourceId": "xhtml/Romans-ap.xhtml#body/147",
      "runs": [
        {
          "text": " ",
          "anchor": "ROM.16.23",
          "marks": [],
          "anchors": [
            "ROM.16.23"
          ],
          "sourceAnchor": "ROM.16.23"
        },
        {
          "verse": "25",
          "anchor": "ROM.16.25",
          "anchors": [
            "ROM.16.25",
            "ROM.14.24"
          ],
          "sourceAnchor": "ROM.16.25"
        },
        {
          "text": " Τῷ δὲ\n  δυναμένῳ ὑμᾶς στηρίξαι κατὰ τὸ εὐαγγέλιόν μου καὶ τὸ κήρυγμα\n  Ἰησοῦ Χριστοῦ, κατὰ ἀποκάλυψιν μυστηρίου χρόνοις αἰωνίοις\n  σεσιγημένου, ",
          "anchor": "ROM.16.25",
          "marks": [],
          "anchors": [
            "ROM.16.25",
            "ROM.14.24"
          ],
          "sourceAnchor": "ROM.16.25"
        },
        {
          "verse": "26",
          "anchor": "ROM.16.26",
          "anchors": [
            "ROM.16.26",
            "ROM.14.25"
          ],
          "sourceAnchor": "ROM.16.26"
        },
        {
          "text": " φανερωθέντος δὲ νῦν διά\n  τε γραφῶν προφητικῶν κατ’ ἐπιταγὴν τοῦ αἰωνίου Θεοῦ εἰς ὑπακοὴν\n  πίστεως εἰς πάντα τὰ ἔθνη γνωρισθέντος, ",
          "anchor": "ROM.16.26",
          "marks": [],
          "anchors": [
            "ROM.16.26",
            "ROM.14.25"
          ],
          "sourceAnchor": "ROM.16.26"
        },
        {
          "verse": "27",
          "anchor": "ROM.16.27",
          "anchors": [
            "ROM.16.27",
            "ROM.14.26"
          ],
          "sourceAnchor": "ROM.16.27"
        },
        {
          "text": " μόνῳ σοφῷ Θεῷ, διὰ Ἰησοῦ Χριστοῦ, ᾧ ἡ δόξα εἰς\n  τοὺς αἰῶνας τῶν αἰώνων· ἀμήν.",
          "anchor": "ROM.16.27",
          "marks": [],
          "anchors": [
            "ROM.16.27",
            "ROM.14.26"
          ],
          "sourceAnchor": "ROM.16.27"
        }
      ]
    }
  ],
  "segments": [
    {
