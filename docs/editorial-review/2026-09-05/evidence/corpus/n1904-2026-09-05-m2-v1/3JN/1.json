          "sourceAnchor": "3JN.1.1"
        },
        {
          "text": " Ὁ\n  πρεσβύτερος Γαΐῳ τῷ ἀγαπητῷ, ὃν ἐγὼ ἀγαπῶ ἐν ἀληθείᾳ.",
          "anchor": "3JN.1.1",
          "marks": [],
          "anchors": [
            "3JN.1.1"
          ],
          "sourceAnchor": "3JN.1.1"
        }
