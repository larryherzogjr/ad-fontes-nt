          "anchor": "1TI.3.16",
          "marks": [],
          "anchors": [
            "1TI.3.16"
          ],
          "sourceAnchor": "1TI.3.16"
        },
        {
          "text": " ἐπιστεύθη ἐν\n  κόσμῳ,",
          "anchor": "1TI.3.16",
          "marks": [],
          "anchors": [
            "1TI.3.16"
          ],
          "sourceAnchor": "1TI.3.16"
        }
      ]
    },
