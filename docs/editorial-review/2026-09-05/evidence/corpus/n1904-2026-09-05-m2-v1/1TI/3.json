          "marks": [],
          "anchors": [
            "1TI.3.16"
          ],
          "sourceAnchor": "1TI.3.16"
        },
        {
          "text": " ὤφθη\n  ἀγγέλοις,",
          "anchor": "1TI.3.16",
          "marks": [],
          "anchors": [
            "1TI.3.16"
          ],
          "sourceAnchor": "1TI.3.16"
        }
      ]
