          ],
          "sourceAnchor": "1TI.3.16"
        },
        {
          "text": " ",
          "anchor": "1TI.3.16",
          "marks": [],
          "anchors": [
            "1TI.3.16"
          ],
          "sourceAnchor": "1TI.3.16"
        },
        {
          "text": " ἀνελήμφθη ἐν\n  δόξῃ.",
          "anchor": "1TI.3.16",
          "marks": [],
          "anchors": [
            "1TI.3.16"
          ],
          "sourceAnchor": "1TI.3.16"
