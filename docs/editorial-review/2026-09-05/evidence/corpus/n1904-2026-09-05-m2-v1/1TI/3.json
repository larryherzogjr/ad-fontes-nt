      "role": "scripture",
      "sourceId": "xhtml/1-Timothy-ap.xhtml#body/16",
      "runs": [
        {
          "text": " ἐκηρύχθη ἐν ἔθνεσιν,",
          "anchor": "1TI.3.16",
          "marks": [],
          "anchors": [
            "1TI.3.16"
          ],
          "sourceAnchor": "1TI.3.16"
        }
      ]
    },
    {
      "marker": "p",
      "role": "scripture",
      "sourceId": "xhtml/1-Timothy-ap.xhtml#body/17",
      "runs": [
        {
