            "MRK.16.1"
          ],
          "sourceAnchor": "MRK.16.1"
        },
        {
          "text": "When the Sabbath was over, Mary Magdalene, Mary the mother of James, and Salome bought spices so they could go and anoint the body of Jesus.",
          "anchor": "MRK.16.1",
          "marks": [],
          "originalText": "When the Sabbath was over, Mary Magdalene, Mary the mother of James, and Salome bought spices so they could go and anoint the body of Jesus. ",
          "anchors": [
            "MRK.16.1"
          ],
          "sourceAnchor": "MRK.16.1"
        },
        {
          "verse": "2",
          "anchor": "MRK.16.2",
          "anchors": [
            "MRK.16.2"
          ],
          "sourceAnchor": "MRK.16.2"
        },
        {
          "text": "Very early on the first day of the week,",
          "anchor": "MRK.16.2",
          "marks": [],
          "originalText": "Very early on the first day of the week,",
          "anchors": [
            "MRK.16.2"
          ],
          "sourceAnchor": "MRK.16.2"
        },
        {
