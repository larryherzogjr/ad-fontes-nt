  ],
  "segments": [
    {
      "id": "REV.1.1",
      "sourceRef": "REV.1.1",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/4/0/0",
      "sourceLabel": "1",
      "anchors": [
        "REV.1.1"
      ],
      "mappingType": "exact",
      "text": "Ἀποκάλυψις Ἰησοῦ Χριστοῦ, ἣν ἔδωκεν αὐτῷ ὁ Θεός, δεῖξαι τοῖς δούλοις αὐτοῦ ἃ δεῖ γενέσθαι ἐν τάχει, καὶ ἐσήμανεν ἀποστείλας διὰ τοῦ ἀγγέλου αὐτοῦ, τῷ δούλῳ αὐτοῦ Ἰωάνῃ,",
      "originalText": "\n  Ἀποκάλυψις Ἰησοῦ Χριστοῦ, ἣν ἔδωκεν αὐτῷ ὁ Θεός, δεῖξαι τοῖς\n  δούλοις αὐτοῦ ἃ δεῖ γενέσθαι ἐν τάχει,\n  καὶ ἐσήμανεν ἀποστείλας διὰ τοῦ ἀγγέλου αὐτοῦ, τῷ δούλῳ αὐτοῦ\n  Ἰωάνῃ, "
    },
    {
      "id": "REV.1.2",
      "sourceRef": "REV.1.2",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/4/0/2",
      "sourceLabel": "2",
      "anchors": [
        "REV.1.2"
      ],
      "mappingType": "exact",
      "text": "ὃς ἐμαρτύρησεν τὸν λόγον τοῦ Θεοῦ καὶ τὴν μαρτυρίαν Ἰησοῦ Χριστοῦ, ὅσα εἶδεν.",
      "originalText": " ὃς ἐμαρτύρησεν τὸν λόγον τοῦ\n  Θεοῦ καὶ τὴν μαρτυρίαν Ἰησοῦ Χριστοῦ, ὅσα εἶδεν. "
    },
    {
      "id": "REV.1.3",
      "sourceRef": "REV.1.3",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/4/0/3",
      "sourceLabel": "3",
      "anchors": [
        "REV.1.3"
      ],
      "mappingType": "exact",
      "text": "Μακάριος ὁ ἀναγινώσκων καὶ οἱ ἀκούοντες τοὺς λόγους τῆς προφητείας καὶ τηροῦντες τὰ ἐν αὐτῇ γεγραμμένα· ὁ γὰρ καιρὸς ἐγγύς.",
      "originalText": " Μακάριος ὁ ἀναγινώσκων καὶ οἱ ἀκούοντες τοὺς λόγους\n  τῆς προφητείας καὶ τηροῦντες τὰ ἐν αὐτῇ γεγραμμένα· ὁ γὰρ καιρὸς\n  ἐγγύς.\n "
    },
    {
      "id": "REV.1.4",
      "sourceRef": "REV.1.4",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/6/0/0",
      "sourceLabel": "4",
      "anchors": [
        "REV.1.4"
      ],
      "mappingType": "exact",
      "text": "Ἰωάνης ταῖς ἑπτὰ ἐκκλησίαις ταῖς ἐν τῇ Ἀσίᾳ· χάρις ὑμῖν καὶ εἰρήνη ἀπὸ ὁ ὢν καὶ ὁ ἦν καὶ ὁ ἐρχόμενος, καὶ ἀπὸ τῶν ἑπτὰ Πνευμάτων ἃ ἐνώπιον τοῦ θρόνου αὐτοῦ,",
      "originalText": " Ἰωάνης\n  ταῖς ἑπτὰ ἐκκλησίαις ταῖς ἐν τῇ Ἀσίᾳ· χάρις ὑμῖν καὶ εἰρήνη ἀπὸ ὁ\n  ὢν καὶ ὁ ἦν καὶ ὁ ἐρχόμενος, καὶ ἀπὸ τῶν ἑπτὰ Πνευμάτων ἃ ἐνώπιον\n  τοῦ θρόνου αὐτοῦ, "
    },
    {
      "id": "REV.1.5",
      "sourceRef": "REV.1.5",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/6/0/1",
      "sourceLabel": "5",
      "anchors": [
        "REV.1.5"
      ],
      "mappingType": "exact",
      "text": "καὶ ἀπὸ Ἰησοῦ Χριστοῦ, ὁ μάρτυς ὁ πιστός, ὁ πρωτότοκος τῶν νεκρῶν καὶ ὁ ἄρχων τῶν βασιλέων τῆς γῆς. Τῷ ἀγαπῶντι ἡμᾶς καὶ λύσαντι ἡμᾶς ἐκ τῶν ἁμαρτιῶν ἡμῶν ἐν τῷ αἵματι αὐτοῦ,",
      "originalText": " καὶ ἀπὸ Ἰησοῦ\n  Χριστοῦ, ὁ μάρτυς ὁ πιστός, ὁ\n  πρωτότοκος τῶν νεκρῶν καὶ ὁ ἄρχων τῶν βασιλέων τῆς γῆς. Τῷ ἀγαπῶντι ἡμᾶς καὶ\n  λύσαντι ἡμᾶς ἐκ τῶν ἁμαρτιῶν ἡμῶν ἐν τῷ\n  αἵματι αὐτοῦ, "
    },
    {
      "id": "REV.1.6",
      "sourceRef": "REV.1.6",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/6/0/6",
      "sourceLabel": "6",
      "anchors": [
        "REV.1.6"
      ],
      "mappingType": "exact",
      "text": "καὶ ἐποίησεν ἡμᾶς βασιλείαν, ἱερεῖς τῷ Θεῷ καὶ Πατρὶ αὐτοῦ, αὐτῷ ἡ δόξα καὶ τὸ κράτος εἰς τοὺς αἰῶνας τῶν αἰώνων· ἀμήν.",
      "originalText": " καὶ ἐποίησεν ἡμᾶς\n  βασιλείαν, ἱερεῖς τῷ Θεῷ καὶ Πατρὶ αὐτοῦ,\n  αὐτῷ ἡ δόξα καὶ τὸ κράτος εἰς τοὺς αἰῶνας τῶν αἰώνων· ἀμήν.\n  "
    },
    {
      "id": "REV.1.7",
      "sourceRef": "REV.1.7",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/6/0/8",
      "sourceLabel": "7",
      "anchors": [
        "REV.1.7"
      ],
      "mappingType": "exact",
      "text": "Ἰδοὺ ἔρχεται μετὰ τῶν νεφελῶν, καὶ ὄψεται αὐτὸν πᾶς ὀφθαλμὸς καὶ οἵτινες αὐτὸν ἐξεκέντησαν, καὶ κόψονται ἐπ’ αὐτὸν πᾶσαι αἱ φυλαὶ τῆς γῆς. ναί, ἀμήν.",
      "originalText": " Ἰδοὺ ἔρχεται μετὰ τῶν\n  νεφελῶν, καὶ ὄψεται αὐτὸν πᾶς\n  ὀφθαλμὸς καὶ οἵτινες αὐτὸν ἐξεκέντησαν, καὶ\n  κόψονται ἐπ’ αὐτὸν πᾶσαι αἱ φυλαὶ τῆς γῆς. ναί,\n  ἀμήν.\n "
    },
    {
      "id": "REV.1.8",
      "sourceRef": "REV.1.8",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/7/0/0",
      "sourceLabel": "8",
      "anchors": [
        "REV.1.8"
      ],
      "mappingType": "exact",
      "text": "Ἐγώ εἰμι τὸ Ἄλφα καὶ τὸ Ὦ, λέγει Κύριος ὁ Θεός, ὁ ὢν καὶ ὁ ἦν καὶ ὁ ἐρχόμενος, ὁ Παντοκράτωρ.",
      "originalText": "\n  Ἐγώ εἰμι τὸ Ἄλφα καὶ τὸ Ὦ, λέγει\n  Κύριος ὁ Θεός, ὁ ὢν καὶ ὁ ἦν καὶ ὁ\n  ἐρχόμενος, ὁ Παντοκράτωρ.\n "
    },
    {
      "id": "REV.1.9",
      "sourceRef": "REV.1.9",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/8/0/0",
      "sourceLabel": "9",
      "anchors": [
        "REV.1.9"
      ],
      "mappingType": "exact",
      "text": "Ἐγὼ Ἰωάνης, ὁ ἀδελφὸς ὑμῶν καὶ συνκοινωνὸς ἐν τῇ θλίψει καὶ βασιλείᾳ καὶ ὑπομονῇ ἐν Ἰησοῦ, ἐγενόμην ἐν τῇ νήσῳ τῇ καλουμένῃ Πάτμῳ διὰ τὸν λόγον τοῦ Θεοῦ καὶ τὴν μαρτυρίαν Ἰησοῦ.",
      "originalText": " Ἐγὼ\n  Ἰωάνης, ὁ ἀδελφὸς ὑμῶν καὶ συνκοινωνὸς ἐν τῇ θλίψει καὶ βασιλείᾳ\n  καὶ ὑπομονῇ ἐν Ἰησοῦ, ἐγενόμην ἐν τῇ νήσῳ τῇ καλουμένῃ Πάτμῳ διὰ\n  τὸν λόγον τοῦ Θεοῦ καὶ τὴν μαρτυρίαν Ἰησοῦ. "
    },
    {
      "id": "REV.1.10",
      "sourceRef": "REV.1.10",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/8/0/1",
      "sourceLabel": "10",
      "anchors": [
        "REV.1.10"
      ],
      "mappingType": "exact",
      "text": "ἐγενόμην ἐν Πνεύματι ἐν τῇ κυριακῇ ἡμέρᾳ, καὶ ἤκουσα ὀπίσω μου φωνὴν μεγάλην ὡς σάλπιγγος",
      "originalText": " ἐγενόμην ἐν Πνεύματι ἐν τῇ κυριακῇ ἡμέρᾳ, καὶ\n  ἤκουσα ὀπίσω μου φωνὴν μεγάλην ὡς σάλπιγγος "
    },
    {
      "id": "REV.1.11",
      "sourceRef": "REV.1.11",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/8/0/2",
      "sourceLabel": "11",
      "anchors": [
        "REV.1.11"
      ],
      "mappingType": "exact",
      "text": "λεγούσης Ὃ βλέπεις γράψον εἰς βιβλίον καὶ πέμψον ταῖς ἑπτὰ ἐκκλησίαις, εἰς Ἔφεσον καὶ εἰς Σμύρναν καὶ εἰς Πέργαμον καὶ εἰς Θυάτειρα καὶ εἰς Σάρδεις καὶ εἰς Φιλαδελφίαν καὶ εἰς Λαοδικίαν.",
      "originalText": " λεγούσης Ὃ βλέπεις γράψον εἰς βιβλίον καὶ πέμψον\n  ταῖς ἑπτὰ ἐκκλησίαις, εἰς Ἔφεσον καὶ εἰς Σμύρναν καὶ εἰς Πέργαμον\n  καὶ εἰς Θυάτειρα καὶ εἰς Σάρδεις καὶ εἰς Φιλαδελφίαν καὶ εἰς\n  Λαοδικίαν. "
    },
    {
      "id": "REV.1.12",
      "sourceRef": "REV.1.12",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/8/0/3",
      "sourceLabel": "12",
      "anchors": [
        "REV.1.12"
      ],
      "mappingType": "exact",
      "text": "Καὶ ἐπέστρεψα βλέπειν τὴν φωνὴν ἥτις ἐλάλει μετ’ ἐμοῦ· καὶ ἐπιστρέψας εἶδον ἑπτὰ λυχνίας χρυσᾶς,",
      "originalText": " Καὶ ἐπέστρεψα βλέπειν τὴν\n  φωνὴν ἥτις ἐλάλει μετ’ ἐμοῦ· καὶ ἐπιστρέψας εἶδον ἑπτὰ λυχνίας\n  χρυσᾶς, "
    },
    {
      "id": "REV.1.13",
      "sourceRef": "REV.1.13",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/8/0/4",
      "sourceLabel": "13",
      "anchors": [
        "REV.1.13"
      ],
      "mappingType": "exact",
      "text": "καὶ ἐν μέσῳ τῶν λυχνιῶν ὅμοιον υἱὸν ἀνθρώπου, ἐνδεδυμένον ποδήρη καὶ περιεζωσμένον πρὸς τοῖς μαστοῖς ζώνην χρυσᾶν·",
      "originalText": " καὶ ἐν μέσῳ τῶν λυχνιῶν\n  ὅμοιον υἱὸν ἀνθρώπου, ἐνδεδυμένον ποδήρη\n  καὶ περιεζωσμένον πρὸς τοῖς μαστοῖς ζώνην\n  χρυσᾶν· "
    },
    {
      "id": "REV.1.14",
      "sourceRef": "REV.1.14",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/8/0/8",
      "sourceLabel": "14",
      "anchors": [
        "REV.1.14"
      ],
      "mappingType": "exact",
      "text": "ἡ δὲ κεφαλὴ αὐτοῦ καὶ αἱ τρίχες λευκαὶ ὡς ἔριον λευκόν ὡς χιών, καὶ οἱ ὀφθαλμοὶ αὐτοῦ ὡς φλὸξ πυρός,",
      "originalText": " ἡ δὲ\n  κεφαλὴ αὐτοῦ καὶ αἱ\n  τρίχες λευκαὶ ὡς ἔριον λευκόν ὡς χιών,\n  καὶ οἱ ὀφθαλμοὶ αὐτοῦ ὡς φλὸξ πυρός, "
    },
    {
      "id": "REV.1.15",
      "sourceRef": "REV.1.15",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/8/0/13",
      "sourceLabel": "15",
      "anchors": [
        "REV.1.15"
      ],
      "mappingType": "exact",
      "text": "καὶ οἱ πόδες αὐτοῦ ὅμοιοι χαλκολιβάνῳ ὡς ἐν καμίνῳ πεπυρωμένης, καὶ ἡ φωνὴ αὐτοῦ ὡς φωνὴ ὑδάτων πολλῶν,",
      "originalText": " καὶ οἱ πόδες αὐτοῦ ὅμοιοι χαλκολιβάνῳ ὡς ἐν καμίνῳ\n  πεπυρωμένης, καὶ ἡ φωνὴ αὐτοῦ ὡς φωνὴ ὑδάτων\n  πολλῶν, "
    },
    {
      "id": "REV.1.16",
      "sourceRef": "REV.1.16",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/8/0/16",
      "sourceLabel": "16",
      "anchors": [
        "REV.1.16"
      ],
      "mappingType": "exact",
      "text": "καὶ ἔχων ἐν τῇ δεξιᾷ χειρὶ αὐτοῦ ἀστέρας ἑπτά, καὶ ἐκ τοῦ στόματος αὐτοῦ ῥομφαία δίστομος ὀξεῖα ἐκπορευομένη, καὶ ἡ ὄψις αὐτοῦ ὡς ὁ ἥλιος φαίνει ἐν τῇ δυνάμει αὐτοῦ.",
      "originalText": " καὶ ἔχων ἐν τῇ δεξιᾷ\n  χειρὶ αὐτοῦ ἀστέρας ἑπτά, καὶ ἐκ τοῦ στόματος αὐτοῦ ῥομφαία\n  δίστομος ὀξεῖα ἐκπορευομένη, καὶ ἡ ὄψις αὐτοῦ ὡς ὁ ἥλιος φαίνει ἐν τῇ δυνάμει\n  αὐτοῦ. "
    },
    {
      "id": "REV.1.17",
      "sourceRef": "REV.1.17",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/8/0/19",
      "sourceLabel": "17",
      "anchors": [
        "REV.1.17"
      ],
      "mappingType": "exact",
      "text": "Καὶ ὅτε εἶδον αὐτόν, ἔπεσα πρὸς τοὺς πόδας αὐτοῦ ὡς νεκρός· καὶ ἔθηκεν τὴν δεξιὰν αὐτοῦ ἐπ’ ἐμὲ λέγων Μὴ φοβοῦ· ἐγώ εἰμι ὁ πρῶτος καὶ ὁ ἔσχατος",
      "originalText": " Καὶ ὅτε εἶδον αὐτόν,\n  ἔπεσα πρὸς τοὺς πόδας αὐτοῦ ὡς νεκρός· καὶ ἔθηκεν τὴν δεξιὰν\n  αὐτοῦ ἐπ’ ἐμὲ λέγων\n Μὴ φοβοῦ· ἐγώ\n  εἰμι ὁ πρῶτος καὶ ὁ ἔσχατος "
    },
    {
      "id": "REV.1.18",
      "sourceRef": "REV.1.18",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/9/0/1",
      "sourceLabel": "18",
      "anchors": [
        "REV.1.18"
      ],
      "mappingType": "exact",
      "text": "καὶ ὁ Ζῶν, καὶ ἐγενόμην νεκρὸς καὶ ἰδοὺ ζῶν εἰμι εἰς τοὺς αἰῶνας τῶν αἰώνων, καὶ ἔχω τὰς κλεῖς τοῦ θανάτου καὶ τοῦ Ἅιδου.",
      "originalText": " καὶ\n  ὁ Ζῶν, καὶ ἐγενόμην νεκρὸς καὶ ἰδοὺ ζῶν\n  εἰμι εἰς τοὺς αἰῶνας τῶν αἰώνων, καὶ ἔχω τὰς κλεῖς τοῦ θανάτου\n  καὶ τοῦ Ἅιδου. "
    },
    {
      "id": "REV.1.19",
      "sourceRef": "REV.1.19",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/9/0/3",
      "sourceLabel": "19",
      "anchors": [
        "REV.1.19"
      ],
      "mappingType": "exact",
      "text": "γράψον οὖν ἃ εἶδες καὶ ἃ εἰσὶν καὶ ἃ μέλλει γενέσθαι μετὰ ταῦτα.",
      "originalText": " γράψον οὖν ἃ εἶδες καὶ\n  ἃ εἰσὶν καὶ ἃ μέλλει γενέσθαι μετὰ ταῦτα.\n  "
    },
    {
      "id": "REV.1.20",
      "sourceRef": "REV.1.20",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/9/0/5",
      "sourceLabel": "20",
      "anchors": [
        "REV.1.20"
      ],
      "mappingType": "exact",
      "text": "τὸ μυστήριον τῶν ἑπτὰ ἀστέρων οὓς εἶδες ἐπὶ τῆς δεξιᾶς μου, καὶ τὰς ἑπτὰ λυχνίας τὰς χρυσᾶς· οἱ ἑπτὰ ἀστέρες ἄγγελοι τῶν ἑπτὰ ἐκκλησιῶν εἰσίν, καὶ αἱ λυχνίαι αἱ ἑπτὰ ἑπτὰ ἐκκλησίαι εἰσίν.",
      "originalText": " τὸ μυστήριον\n  τῶν ἑπτὰ ἀστέρων οὓς εἶδες ἐπὶ τῆς δεξιᾶς μου, καὶ τὰς ἑπτὰ\n  λυχνίας τὰς χρυσᾶς· οἱ ἑπτὰ ἀστέρες ἄγγελοι τῶν ἑπτὰ ἐκκλησιῶν\n  εἰσίν, καὶ αἱ λυχνίαι αἱ ἑπτὰ ἑπτὰ ἐκκλησίαι εἰσίν."
    }
  ],
