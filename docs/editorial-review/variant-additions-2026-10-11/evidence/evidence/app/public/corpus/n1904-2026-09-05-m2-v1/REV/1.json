          "marks": [],
          "anchors": [
            "REV.1.19"
          ],
          "sourceAnchor": "REV.1.19"
        },
        {
          "verse": "20",
          "anchor": "REV.1.20",
          "anchors": [
            "REV.1.20"
          ],
          "sourceAnchor": "REV.1.20"
        },
        {
          "text": " τὸ ",
          "anchor": "REV.1.20",
          "marks": [],
          "anchors": [
            "REV.1.20"
          ],
          "sourceAnchor": "REV.1.20"
        },
        {
          "text": "μυστήριον",
          "anchor": "REV.1.20",
          "marks": [],
          "anchors": [
            "REV.1.20"
          ],
          "sourceAnchor": "REV.1.20"
        },
        {
          "text": "\n  τῶν ἑπτὰ ἀστέρων οὓς εἶδες ἐπὶ τῆς δεξιᾶς μου, καὶ τὰς ἑπτὰ\n  λυχνίας τὰς χρυσᾶς· οἱ ἑπτὰ ἀστέρες ἄγγελοι τῶν ἑπτὰ ἐκκλησιῶν\n  εἰσίν, καὶ αἱ λυχνίαι αἱ ἑπτὰ ἑπτὰ ἐκκλησίαι εἰσίν.",
          "anchor": "REV.1.20",
          "marks": [],
          "anchors": [
            "REV.1.20"
          ],
          "sourceAnchor": "REV.1.20"
        }
