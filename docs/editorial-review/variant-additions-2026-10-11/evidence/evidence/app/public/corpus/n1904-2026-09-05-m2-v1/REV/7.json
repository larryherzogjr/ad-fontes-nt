        },
        {
          "verse": "17",
          "anchor": "REV.7.17",
          "anchors": [
            "REV.7.17"
          ],
          "sourceAnchor": "REV.7.17"
        },
        {
          "text": "\n  ",
          "anchor": "REV.7.17",
          "marks": [],
          "anchors": [
            "REV.7.17"
          ],
          "sourceAnchor": "REV.7.17"
        },
        {
          "text": "ὅτι τὸ Ἀρνίον τὸ ἀνὰ μέσον τοῦ θρόνου",
          "anchor": "REV.7.17",
          "marks": [],
          "anchors": [
            "REV.7.17"
          ],
          "sourceAnchor": "REV.7.17"
        },
        {
          "text": "\n  ",
          "anchor": "REV.7.17",
          "marks": [],
          "anchors": [
            "REV.7.17"
          ],
          "sourceAnchor": "REV.7.17"
        },
        {
          "text": "ποιμανεῖ αὐτούς καὶ ὁδηγήσει αὐτοὺς ἐπὶ ζωῆς\n  πηγὰς ὑδάτων· καὶ ἐξαλείψει ὁ Θεὸς πᾶν δάκρυον ἐκ τῶν\n  ὀφθαλμῶν",
          "anchor": "REV.7.17",
          "marks": [],
          "anchors": [
            "REV.7.17"
          ],
          "sourceAnchor": "REV.7.17"
        },
        {
          "text": " ",
          "anchor": "REV.7.17",
          "marks": [],
          "anchors": [
            "REV.7.17"
          ],
          "sourceAnchor": "REV.7.17"
        },
        {
          "text": "αὐτῶν.",
          "anchor": "REV.7.17",
          "marks": [],
          "anchors": [
            "REV.7.17"
          ],
