  ],
  "segments": [
    {
      "id": "REV.7.1",
      "sourceRef": "REV.7.1",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/54/0/0",
      "sourceLabel": "1",
      "anchors": [
        "REV.7.1"
      ],
      "mappingType": "exact",
      "text": "Μετὰ τοῦτο εἶδον τέσσαρας ἀγγέλους ἑστῶτας ἐπὶ τὰς τέσσαρας γωνίας τῆς γῆς, κρατοῦντας τοὺς τέσσαρας ἀνέμους τῆς γῆς, ἵνα μὴ πνέῃ ἄνεμος ἐπὶ τῆς γῆς μήτε ἐπὶ τῆς θαλάσσης μήτε ἐπὶ πᾶν δένδρον.",
      "originalText": " Μετὰ\n  τοῦτο εἶδον τέσσαρας ἀγγέλους ἑστῶτας ἐπὶ τὰς\n  τέσσαρας γωνίας τῆς γῆς, κρατοῦντας τοὺς\n  τέσσαρας ἀνέμους τῆς γῆς, ἵνα μὴ πνέῃ ἄνεμος ἐπὶ τῆς γῆς\n  μήτε ἐπὶ τῆς θαλάσσης μήτε ἐπὶ πᾶν δένδρον. "
    },
    {
      "id": "REV.7.2",
      "sourceRef": "REV.7.2",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/54/0/3",
      "sourceLabel": "2",
      "anchors": [
        "REV.7.2"
      ],
      "mappingType": "exact",
      "text": "καὶ εἶδον ἄλλον ἄγγελον ἀναβαίνοντα ἀπὸ ἀνατολῆς ἡλίου, ἔχοντα σφραγῖδα Θεοῦ ζῶντος, καὶ ἔκραξεν φωνῇ μεγάλῃ τοῖς τέσσαρσιν ἀγγέλοις οἷς ἐδόθη αὐτοῖς ἀδικῆσαι τὴν γῆν καὶ τὴν θάλασσαν,",
      "originalText": " καὶ εἶδον ἄλλον ἄγγελον ἀναβαίνοντα ἀπὸ ἀνατολῆς\n  ἡλίου, ἔχοντα σφραγῖδα Θεοῦ ζῶντος, καὶ ἔκραξεν φωνῇ μεγάλῃ τοῖς\n  τέσσαρσιν ἀγγέλοις οἷς ἐδόθη αὐτοῖς ἀδικῆσαι τὴν γῆν καὶ τὴν\n  θάλασσαν, "
    },
    {
      "id": "REV.7.3",
      "sourceRef": "REV.7.3",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/54/0/4",
      "sourceLabel": "3",
      "anchors": [
        "REV.7.3"
      ],
      "mappingType": "exact",
      "text": "λέγων Μὴ ἀδικήσητε τὴν γῆν μήτε τὴν θάλασσαν μήτε τὰ δένδρα, ἄχρι σφραγίσωμεν τοὺς δούλους τοῦ Θεοῦ ἡμῶν ἐπὶ τῶν μετώπων αὐτῶν.",
      "originalText": " λέγων Μὴ ἀδικήσητε τὴν γῆν\n  μήτε τὴν θάλασσαν μήτε τὰ δένδρα, ἄχρι σφραγίσωμεν τοὺς δούλους τοῦ Θεοῦ ἡμῶν ἐπὶ τῶν μετώπων αὐτῶν. "
    },
    {
      "id": "REV.7.4",
      "sourceRef": "REV.7.4",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/54/0/7",
      "sourceLabel": "4",
      "anchors": [
        "REV.7.4"
      ],
      "mappingType": "exact",
      "text": "Καὶ ἤκουσα τὸν ἀριθμὸν τῶν ἐσφραγισμένων, ἑκατὸν τεσσεράκοντα τέσσαρες χιλιάδες ἐσφραγισμένοι ἐκ πάσης φυλῆς υἱῶν Ἰσραήλ·",
      "originalText": " Καὶ\n  ἤκουσα τὸν ἀριθμὸν τῶν ἐσφραγισμένων, ἑκατὸν τεσσεράκοντα\n  τέσσαρες χιλιάδες ἐσφραγισμένοι ἐκ πάσης φυλῆς υἱῶν\n  Ἰσραήλ·\n "
    },
    {
      "id": "REV.7.5",
      "sourceRef": "REV.7.5",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/55/0/0",
      "sourceLabel": "5",
      "anchors": [
        "REV.7.5"
      ],
      "mappingType": "exact",
      "text": "ἐκ φυλῆς Ἰούδα δώδεκα χιλιάδες ἐσφραγισμένοι, ἐκ φυλῆς Ῥουβὴν δώδεκα χιλιάδες, ἐκ φυλῆς Γὰδ δώδεκα χιλιάδες,",
      "originalText": " ἐκ\n  φυλῆς Ἰούδα δώδεκα χιλιάδες ἐσφραγισμένοι,\n ἐκ φυλῆς Ῥουβὴν δώδεκα\n  χιλιάδες,\n ἐκ φυλῆς Γὰδ δώδεκα\n  χιλιάδες,\n "
    },
    {
      "id": "REV.7.6",
      "sourceRef": "REV.7.6",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/58/0/0",
      "sourceLabel": "6",
      "anchors": [
        "REV.7.6"
      ],
      "mappingType": "exact",
      "text": "ἐκ φυλῆς Ἀσὴρ δώδεκα χιλιάδες, ἐκ φυλῆς Νεφθαλεὶμ δώδεκα χιλιάδες, ἐκ φυλῆς Μανασσῆ δώδεκα χιλιάδες,",
      "originalText": " ἐκ\n  φυλῆς Ἀσὴρ δώδεκα χιλιάδες,\n ἐκ φυλῆς Νεφθαλεὶμ δώδεκα\n  χιλιάδες,\n ἐκ φυλῆς Μανασσῆ δώδεκα\n  χιλιάδες,\n "
    },
    {
      "id": "REV.7.7",
      "sourceRef": "REV.7.7",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/61/0/0",
      "sourceLabel": "7",
      "anchors": [
        "REV.7.7"
      ],
      "mappingType": "exact",
      "text": "ἐκ φυλῆς Συμεὼν δώδεκα χιλιάδες, ἐκ φυλῆς Λευεὶ δώδεκα χιλιάδες, ἐκ φυλῆς Ἰσσαχὰρ δώδεκα χιλιάδες,",
      "originalText": " ἐκ\n  φυλῆς Συμεὼν δώδεκα χιλιάδες,\n ἐκ φυλῆς Λευεὶ δώδεκα\n  χιλιάδες,\n ἐκ φυλῆς Ἰσσαχὰρ δώδεκα\n  χιλιάδες,\n "
    },
    {
      "id": "REV.7.8",
      "sourceRef": "REV.7.8",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/64/0/0",
      "sourceLabel": "8",
      "anchors": [
        "REV.7.8"
      ],
      "mappingType": "exact",
      "text": "ἐκ φυλῆς Ζαβουλὼν δώδεκα χιλιάδες, ἐκ φυλῆς Ἰωσὴφ δώδεκα χιλιάδες, ἐκ φυλῆς Βενιαμεὶν δώδεκα χιλιάδες ἐσφραγισμένοι.",
      "originalText": " ἐκ\n  φυλῆς Ζαβουλὼν δώδεκα χιλιάδες,\n ἐκ φυλῆς Ἰωσὴφ δώδεκα\n  χιλιάδες,\n ἐκ φυλῆς Βενιαμεὶν δώδεκα\n  χιλιάδες ἐσφραγισμένοι.\n"
    },
    {
      "id": "REV.7.9",
      "sourceRef": "REV.7.9",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/67/0",
      "sourceLabel": "9",
      "anchors": [
        "REV.7.9"
      ],
      "mappingType": "exact",
      "text": "Μετὰ ταῦτα εἶδον, καὶ ἰδοὺ ὄχλος πολύς, ὃν ἀριθμῆσαι αὐτὸν οὐδεὶς ἐδύνατο, ἐκ παντὸς ἔθνους καὶ φυλῶν καὶ λαῶν καὶ γλωσσῶν, ἑστῶτες ἐνώπιον τοῦ θρόνου καὶ ἐνώπιον τοῦ Ἀρνίου, περιβεβλημένους στολὰς λευκάς, καὶ φοίνικες ἐν ταῖς χερσὶν αὐτῶν·",
      "originalText": " Μετὰ ταῦτα εἶδον,\n  καὶ ἰδοὺ ὄχλος πολύς, ὃν ἀριθμῆσαι αὐτὸν οὐδεὶς ἐδύνατο, ἐκ\n  παντὸς ἔθνους καὶ φυλῶν καὶ λαῶν καὶ γλωσσῶν, ἑστῶτες ἐνώπιον τοῦ\n  θρόνου καὶ ἐνώπιον τοῦ Ἀρνίου, περιβεβλημένους στολὰς λευκάς, καὶ\n  φοίνικες ἐν ταῖς χερσὶν αὐτῶν· "
    },
    {
      "id": "REV.7.10",
      "sourceRef": "REV.7.10",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/67/1",
      "sourceLabel": "10",
      "anchors": [
        "REV.7.10"
      ],
      "mappingType": "exact",
      "text": "καὶ κράζουσιν φωνῇ μεγάλῃ λέγοντες Ἡ σωτηρία τῷ Θεῷ ἡμῶν τῷ καθημένῳ ἐπὶ τῷ θρόνῳ καὶ τῷ Ἀρνίῳ.",
      "originalText": " καὶ\n  κράζουσιν φωνῇ μεγάλῃ λέγοντες\n Ἡ σωτηρία τῷ Θεῷ ἡμῶν τῷ\n  καθημένῳ ἐπὶ τῷ θρόνῳ καὶ τῷ\n  Ἀρνίῳ.\n"
    },
    {
      "id": "REV.7.11",
      "sourceRef": "REV.7.11",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/69/0",
      "sourceLabel": "11",
      "anchors": [
        "REV.7.11"
      ],
      "mappingType": "exact",
      "text": "καὶ πάντες οἱ ἄγγελοι εἱστήκεισαν κύκλῳ τοῦ θρόνου καὶ τῶν πρεσβυτέρων καὶ τῶν τεσσάρων ζῴων, καὶ ἔπεσαν ἐνώπιον τοῦ θρόνου ἐπὶ τὰ πρόσωπα αὐτῶν καὶ προσεκύνησαν τῷ Θεῷ,",
      "originalText": " καὶ πάντες οἱ\n  ἄγγελοι εἱστήκεισαν κύκλῳ τοῦ θρόνου καὶ τῶν πρεσβυτέρων καὶ τῶν\n  τεσσάρων ζῴων, καὶ ἔπεσαν ἐνώπιον τοῦ θρόνου ἐπὶ τὰ πρόσωπα αὐτῶν\n  καὶ προσεκύνησαν τῷ Θεῷ, "
    },
    {
      "id": "REV.7.12",
      "sourceRef": "REV.7.12",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/69/1",
      "sourceLabel": "12",
      "anchors": [
        "REV.7.12"
      ],
      "mappingType": "exact",
      "text": "λέγοντες Ἀμήν, ἡ εὐλογία καὶ ἡ δόξα καὶ ἡ σοφία καὶ ἡ εὐχαριστία καὶ ἡ τιμὴ καὶ ἡ δύναμις καὶ ἡ ἰσχὺς τῷ Θεῷ ἡμῶν εἰς τοὺς αἰῶνας τῶν αἰώνων· ἀμήν.",
      "originalText": " λέγοντες\n Ἀμήν, ἡ εὐλογία καὶ ἡ δόξα καὶ ἡ\n  σοφία καὶ ἡ εὐχαριστία καὶ ἡ τιμὴ καὶ ἡ δύναμις καὶ ἡ\n   ἰσχὺς τῷ Θεῷ ἡμῶν εἰς τοὺς αἰῶνας τῶν αἰώνων·\n  ἀμήν.\n"
    },
    {
      "id": "REV.7.13",
      "sourceRef": "REV.7.13",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/71/0",
      "sourceLabel": "13",
      "anchors": [
        "REV.7.13"
      ],
      "mappingType": "exact",
      "text": "Καὶ ἀπεκρίθη εἷς ἐκ τῶν πρεσβυτέρων λέγων μοι Οὗτοι οἱ περιβεβλημένοι τὰς στολὰς τὰς λευκὰς τίνες εἰσὶν καὶ πόθεν ἦλθον;",
      "originalText": " Καὶ ἀπεκρίθη εἷς\n  ἐκ τῶν πρεσβυτέρων λέγων μοι Οὗτοι οἱ περιβεβλημένοι τὰς στολὰς\n  τὰς λευκὰς τίνες εἰσὶν καὶ πόθεν ἦλθον; "
    },
    {
      "id": "REV.7.14",
      "sourceRef": "REV.7.14",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/71/1",
      "sourceLabel": "14",
      "anchors": [
        "REV.7.14"
      ],
      "mappingType": "exact",
      "text": "καὶ εἴρηκα αὐτῷ Κύριέ μου, σὺ οἶδας. καὶ εἶπέν μοι Οὗτοί εἰσιν οἱ ἐρχόμενοι ἐκ τῆς θλίψεως τῆς μεγάλης, καὶ ἔπλυναν τὰς στολὰς αὐτῶν καὶ ἐλεύκαναν αὐτὰς ἐν τῷ αἵματι τοῦ Ἀρνίου.",
      "originalText": " καὶ εἴρηκα αὐτῷ Κύριέ μου, σὺ\n  οἶδας. καὶ εἶπέν μοι Οὗτοί εἰσιν οἱ ἐρχόμενοι ἐκ τῆς\n  θλίψεως τῆς μεγάλης,\n  καὶ ἔπλυναν τὰς στολὰς αὐτῶν\n  καὶ ἐλεύκαναν αὐτὰς ἐν τῷ αἵματι τοῦ\n  Ἀρνίου. "
    },
    {
      "id": "REV.7.15",
      "sourceRef": "REV.7.15",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/71/7",
      "sourceLabel": "15",
      "anchors": [
        "REV.7.15"
      ],
      "mappingType": "exact",
      "text": "διὰ τοῦτό εἰσιν ἐνώπιον τοῦ θρόνου τοῦ Θεοῦ, καὶ λατρεύουσιν αὐτῷ ἡμέρας καὶ νυκτὸς ἐν τῷ ναῷ αὐτοῦ, καὶ ὁ καθήμενος ἐπὶ τοῦ θρόνου σκηνώσει ἐπ’ αὐτούς.",
      "originalText": " διὰ\n  τοῦτό εἰσιν ἐνώπιον τοῦ θρόνου τοῦ Θεοῦ, καὶ λατρεύουσιν αὐτῷ\n  ἡμέρας καὶ νυκτὸς ἐν τῷ ναῷ αὐτοῦ, καὶ ὁ καθήμενος ἐπὶ τοῦ θρόνου σκηνώσει\n  ἐπ’ αὐτούς. "
    },
    {
      "id": "REV.7.16",
      "sourceRef": "REV.7.16",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/71/11",
      "sourceLabel": "16",
      "anchors": [
        "REV.7.16"
      ],
      "mappingType": "exact",
      "text": "οὐ πεινάσουσιν ἔτι οὐδὲ διψήσουσιν ἔτι, οὐδὲ μὴ πέσῃ ἐπ’ αὐτοὺς ὁ ἥλιος οὐδὲ πᾶν καῦμα,",
      "originalText": " οὐ\n  πεινάσουσιν ἔτι οὐδὲ διψήσουσιν ἔτι,\n  οὐδὲ μὴ πέσῃ ἐπ’ αὐτοὺς ὁ ἥλιος οὐδὲ πᾶν\n  καῦμα, "
    },
    {
      "id": "REV.7.17",
      "sourceRef": "REV.7.17",
      "sourceId": "xhtml/Revelation-ap.xhtml#body/71/18",
      "sourceLabel": "17",
      "anchors": [
        "REV.7.17"
      ],
      "mappingType": "exact",
      "text": "ὅτι τὸ Ἀρνίον τὸ ἀνὰ μέσον τοῦ θρόνου ποιμανεῖ αὐτούς καὶ ὁδηγήσει αὐτοὺς ἐπὶ ζωῆς πηγὰς ὑδάτων· καὶ ἐξαλείψει ὁ Θεὸς πᾶν δάκρυον ἐκ τῶν ὀφθαλμῶν αὐτῶν.",
      "originalText": "\n  ὅτι τὸ Ἀρνίον τὸ ἀνὰ μέσον τοῦ θρόνου\n  ποιμανεῖ αὐτούς καὶ ὁδηγήσει αὐτοὺς ἐπὶ ζωῆς\n  πηγὰς ὑδάτων· καὶ ἐξαλείψει ὁ Θεὸς πᾶν δάκρυον ἐκ τῶν\n  ὀφθαλμῶν αὐτῶν."
    }
  ],
