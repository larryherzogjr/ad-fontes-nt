          "anchors": [
            "REV.7.1"
          ],
          "sourceAnchor": "REV.7.1"
        },
        {
          "text": " Μετὰ\n  τοῦτο εἶδον τέσσαρας ἀγγέλους ἑστῶτας ",
          "anchor": "REV.7.1",
          "marks": [],
          "anchors": [
            "REV.7.1"
          ],
          "sourceAnchor": "REV.7.1"
        },
        {
          "text": "ἐπὶ τὰς\n  τέσσαρας γωνίας τῆς γῆς",
          "anchor": "REV.7.1",
          "marks": [],
          "anchors": [
            "REV.7.1"
          ],
          "sourceAnchor": "REV.7.1"
        },
        {
          "text": ", κρατοῦντας ",
          "anchor": "REV.7.1",
          "marks": [],
          "anchors": [
            "REV.7.1"
          ],
          "sourceAnchor": "REV.7.1"
        },
        {
          "text": "τοὺς\n  τέσσαρας ἀνέμους",
          "anchor": "REV.7.1",
          "marks": [],
          "anchors": [
            "REV.7.1"
          ],
          "sourceAnchor": "REV.7.1"
        },
        {
          "text": " τῆς γῆς, ἵνα μὴ πνέῃ ἄνεμος ἐπὶ τῆς γῆς\n  μήτε ἐπὶ τῆς θαλάσσης μήτε ἐπὶ πᾶν δένδρον. ",
          "anchor": "REV.7.1",
          "marks": [],
          "anchors": [
            "REV.7.1"
          ],
          "sourceAnchor": "REV.7.1"
        },
        {
          "verse": "2",
          "anchor": "REV.7.2",
          "anchors": [
            "REV.7.2"
          ],
          "sourceAnchor": "REV.7.2"
        },
        {
          "text": " καὶ εἶδον ἄλλον ἄγγελον ἀναβαίνοντα ἀπὸ ἀνατολῆς\n  ἡλίου, ἔχοντα σφραγῖδα Θεοῦ ζῶντος, καὶ ἔκραξεν φωνῇ μεγάλῃ τοῖς\n  τέσσαρσιν ἀγγέλοις οἷς ἐδόθη αὐτοῖς ἀδικῆσαι τὴν γῆν καὶ τὴν\n  θάλασσαν, ",
          "anchor": "REV.7.2",
          "marks": [],
          "anchors": [
            "REV.7.2"
          ],
          "sourceAnchor": "REV.7.2"
        },
        {
          "verse": "3",
          "anchor": "REV.7.3",
          "anchors": [
            "REV.7.3"
          ],
          "sourceAnchor": "REV.7.3"
        },
        {
          "text": " λέγων Μὴ ἀδικήσητε τὴν γῆν\n  μήτε τὴν θάλασσαν μήτε τὰ δένδρα, ἄχρι ",
          "anchor": "REV.7.3",
          "marks": [],
          "anchors": [
            "REV.7.3"
          ],
          "sourceAnchor": "REV.7.3"
        },
        {
          "text": "σφραγίσωμεν",
          "anchor": "REV.7.3",
          "marks": [],
          "anchors": [
            "REV.7.3"
          ],
          "sourceAnchor": "REV.7.3"
        },
        {
          "text": " τοὺς δούλους τοῦ Θεοῦ ἡμῶν ",
          "anchor": "REV.7.3",
          "marks": [],
          "anchors": [
            "REV.7.3"
          ],
          "sourceAnchor": "REV.7.3"
        },
        {
          "text": "ἐπὶ τῶν μετώπων",
          "anchor": "REV.7.3",
          "marks": [],
          "anchors": [
            "REV.7.3"
          ],
          "sourceAnchor": "REV.7.3"
        },
        {
          "text": " αὐτῶν. ",
          "anchor": "REV.7.3",
          "marks": [],
          "anchors": [
            "REV.7.3"
          ],
          "sourceAnchor": "REV.7.3"
        },
        {
          "verse": "4",
          "anchor": "REV.7.4",
          "anchors": [
            "REV.7.4"
          ],
          "sourceAnchor": "REV.7.4"
        },
        {
          "text": " Καὶ\n  ἤκουσα τὸν ἀριθμὸν τῶν ἐσφραγισμένων, ἑκατὸν τεσσεράκοντα\n  τέσσαρες χιλιάδες ἐσφραγισμένοι ἐκ πάσης φυλῆς υἱῶν\n  Ἰσραήλ·",
          "anchor": "REV.7.4",
          "marks": [],
          "anchors": [
            "REV.7.4"
          ],
          "sourceAnchor": "REV.7.4"
        }
