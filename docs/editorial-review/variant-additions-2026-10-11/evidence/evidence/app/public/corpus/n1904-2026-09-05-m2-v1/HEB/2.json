          "marks": [],
          "anchors": [
            "HEB.2.12"
          ],
          "sourceAnchor": "HEB.2.12"
        },
        {
          "text": "Ἀπαγγελῶ τὸ\n  ὄνομά σου τοῖς ἀδελφοῖς μου,",
          "anchor": "HEB.2.12",
          "marks": [],
          "anchors": [
            "HEB.2.12"
          ],
          "sourceAnchor": "HEB.2.12"
        }
