      "role": "scripture",
      "sourceId": "xhtml/Hebrews-ap.xhtml#body/36",
      "runs": [
        {
          "text": " ἢ υἱὸς ἀνθρώπου ὅτι ἐπισκέπτῃ\n  αὐτόν;",
          "anchor": "HEB.2.6",
          "marks": [],
          "anchors": [
            "HEB.2.6"
          ],
          "sourceAnchor": "HEB.2.6"
        }
      ]
    },
    {
