      "sourceId": "xhtml/Hebrews-ap.xhtml#body/42",
      "runs": [
        {
          "text": " ἐν μέσῳ ἐκκλησίας ὑμνήσω σε·",
          "anchor": "HEB.2.12",
          "marks": [],
          "anchors": [
