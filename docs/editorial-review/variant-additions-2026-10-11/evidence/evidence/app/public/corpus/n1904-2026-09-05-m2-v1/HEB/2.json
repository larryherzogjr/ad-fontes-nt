      "sourceId": "xhtml/Hebrews-ap.xhtml#body/40",
      "runs": [
        {
          "text": "ἐν τῷ γὰρ ",
          "anchor": "HEB.2.8",
          "marks": [],
          "anchors": [
            "HEB.2.8"
          ],
          "sourceAnchor": "HEB.2.8"
        },
        {
          "text": "ὑποτάξαι",
          "anchor": "HEB.2.8",
          "marks": [],
          "anchors": [
            "HEB.2.8"
          ],
          "sourceAnchor": "HEB.2.8"
        },
        {
          "text": "\n  αὐτῷ τὰ ",
          "anchor": "HEB.2.8",
          "marks": [],
          "anchors": [
            "HEB.2.8"
          ],
          "sourceAnchor": "HEB.2.8"
        },
        {
          "text": "πάντα",
          "anchor": "HEB.2.8",
          "marks": [],
          "anchors": [
            "HEB.2.8"
          ],
          "sourceAnchor": "HEB.2.8"
        },
        {
          "text": " οὐδὲν ἀφῆκεν αὐτῷ\n  ἀνυπότακτον. νῦν δὲ οὔπω ὁρῶμεν αὐτῷ τὰ ",
          "anchor": "HEB.2.8",
          "marks": [],
          "anchors": [
            "HEB.2.8"
          ],
          "sourceAnchor": "HEB.2.8"
        },
        {
          "text": "πάντα\n  ὑποτεταγμένα",
          "anchor": "HEB.2.8",
          "marks": [],
          "anchors": [
            "HEB.2.8"
          ],
          "sourceAnchor": "HEB.2.8"
        },
        {
          "text": "· ",
          "anchor": "HEB.2.8",
          "marks": [],
          "anchors": [
            "HEB.2.8"
          ],
          "sourceAnchor": "HEB.2.8"
        },
        {
          "verse": "9",
          "anchor": "HEB.2.9",
          "anchors": [
            "HEB.2.9"
          ],
          "sourceAnchor": "HEB.2.9"
        },
        {
          "text": " τὸν δὲ\n  ",
          "anchor": "HEB.2.9",
          "marks": [],
          "anchors": [
            "HEB.2.9"
          ],
          "sourceAnchor": "HEB.2.9"
        },
        {
          "text": "βραχύ τι παρ’ ἀγγέλους ἠλαττωμένον",
          "anchor": "HEB.2.9",
          "marks": [],
          "anchors": [
            "HEB.2.9"
          ],
          "sourceAnchor": "HEB.2.9"
        },
        {
          "text": "\n  βλέπομεν Ἰησοῦν διὰ τὸ πάθημα τοῦ θανάτου ",
          "anchor": "HEB.2.9",
          "marks": [],
          "anchors": [
            "HEB.2.9"
          ],
          "sourceAnchor": "HEB.2.9"
        },
        {
          "text": "δόξῃ\n  καὶ τιμῇ ἐστεφανωμένον",
          "anchor": "HEB.2.9",
          "marks": [],
          "anchors": [
            "HEB.2.9"
          ],
          "sourceAnchor": "HEB.2.9"
        },
        {
          "text": ", ὅπως χάριτι Θεοῦ ὑπὲρ παντὸς\n  γεύσηται θανάτου. ",
          "anchor": "HEB.2.9",
          "marks": [],
          "anchors": [
            "HEB.2.9"
          ],
          "sourceAnchor": "HEB.2.9"
        },
        {
          "verse": "10",
          "anchor": "HEB.2.10",
          "anchors": [
            "HEB.2.10"
          ],
          "sourceAnchor": "HEB.2.10"
        },
        {
          "text": " Ἔπρεπεν γὰρ αὐτῷ,\n  δι’ ὃν τὰ πάντα καὶ δι’ οὗ τὰ πάντα, πολλοὺς υἱοὺς εἰς δόξαν\n  ἀγαγόντα τὸν ἀρχηγὸν τῆς σωτηρίας αὐτῶν διὰ παθημάτων τελειῶσαι.\n  ",
          "anchor": "HEB.2.10",
          "marks": [],
          "anchors": [
            "HEB.2.10"
          ],
          "sourceAnchor": "HEB.2.10"
        },
        {
          "verse": "11",
          "anchor": "HEB.2.11",
          "anchors": [
            "HEB.2.11"
          ],
          "sourceAnchor": "HEB.2.11"
        },
        {
          "text": " ὅ τε γὰρ ἁγιάζων καὶ οἱ ἁγιαζόμενοι ἐξ\n  ἑνὸς πάντες· δι’ ἣν αἰτίαν οὐκ ἐπαισχύνεται ",
          "anchor": "HEB.2.11",
          "marks": [],
          "anchors": [
            "HEB.2.11"
          ],
          "sourceAnchor": "HEB.2.11"
        },
        {
          "text": "ἀδελφοὺς",
          "anchor": "HEB.2.11",
          "marks": [],
          "anchors": [
            "HEB.2.11"
          ],
          "sourceAnchor": "HEB.2.11"
        },
        {
          "text": " αὐτοὺς καλεῖν, ",
          "anchor": "HEB.2.11",
          "marks": [],
          "anchors": [
            "HEB.2.11"
          ],
          "sourceAnchor": "HEB.2.11"
        },
        {
          "verse": "12",
          "anchor": "HEB.2.12",
          "anchors": [
            "HEB.2.12"
          ],
          "sourceAnchor": "HEB.2.12"
        },
        {
          "text": "\n  λέγων",
          "anchor": "HEB.2.12",
          "marks": [],
          "anchors": [
            "HEB.2.12"
          ],
          "sourceAnchor": "HEB.2.12"
        }
      ]
    },
    {
      "marker": "p",
      "role": "scripture",
