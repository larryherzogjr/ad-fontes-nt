          "marks": [],
          "anchors": [
            "HEB.2.13"
          ],
          "sourceAnchor": "HEB.2.13"
        },
        {
          "text": "Ἐγὼ ἔσομαι\n  πεποιθὼς ἐπ’ αὐτῷ·",
          "anchor": "HEB.2.13",
          "marks": [],
          "anchors": [
            "HEB.2.13"
          ],
          "sourceAnchor": "HEB.2.13"
