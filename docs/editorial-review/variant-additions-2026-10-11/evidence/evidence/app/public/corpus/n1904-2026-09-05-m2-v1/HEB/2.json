          "marks": [],
          "anchors": [
            "HEB.2.7"
          ],
          "sourceAnchor": "HEB.2.7"
        },
        {
          "text": "ἠλάττωσας αὐτὸν βραχύ τι παρ’\n  ἀγγέλους,",
          "anchor": "HEB.2.7",
          "marks": [],
          "anchors": [
