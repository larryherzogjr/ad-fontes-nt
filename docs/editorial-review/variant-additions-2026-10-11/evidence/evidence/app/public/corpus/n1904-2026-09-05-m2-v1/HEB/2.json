      "sourceId": "xhtml/Hebrews-ap.xhtml#body/45",
      "runs": [
        {
          "text": "καὶ πάλιν",
          "anchor": "HEB.2.13",
          "marks": [],
          "anchors": [
            "HEB.2.13"
          ],
          "sourceAnchor": "HEB.2.13"
        }
      ]
    },
    {
      "marker": "p",
      "role": "scripture",
      "sourceId": "xhtml/Hebrews-ap.xhtml#body/46",
      "runs": [
        {
          "text": " ",
          "anchor": "HEB.2.13",
          "marks": [],
          "anchors": [
            "HEB.2.13"
          ],
          "sourceAnchor": "HEB.2.13"
        },
        {
          "text": "Ἰδοὺ ἐγὼ καὶ τὰ\n  παιδία ἅ μοι ἔδωκεν ὁ Θεός.",
          "anchor": "HEB.2.13",
          "marks": [],
          "anchors": [
            "HEB.2.13"
          ],
          "sourceAnchor": "HEB.2.13"
        }
      ]
    },
    {
      "marker": "p",
      "role": "scripture",
      "sourceId": "xhtml/Hebrews-ap.xhtml#body/47",
      "runs": [
        {
          "verse": "14",
          "anchor": "HEB.2.14",
          "anchors": [
            "HEB.2.14"
          ],
          "sourceAnchor": "HEB.2.14"
        },
        {
          "text": " ἐπεὶ οὖν\n  ",
          "anchor": "HEB.2.14",
          "marks": [],
          "anchors": [
            "HEB.2.14"
          ],
          "sourceAnchor": "HEB.2.14"
        },
        {
          "text": "τὰ παιδία",
          "anchor": "HEB.2.14",
          "marks": [],
          "anchors": [
            "HEB.2.14"
          ],
          "sourceAnchor": "HEB.2.14"
        },
        {
          "text": " κεκοινώνηκεν αἵματος καὶ\n  σαρκός, καὶ αὐτὸς παραπλησίως μετέσχεν τῶν αὐτῶν, ἵνα διὰ τοῦ\n  θανάτου καταργήσῃ τὸν τὸ κράτος ἔχοντα τοῦ θανάτου, τοῦτ’ ἔστιν\n  τὸν διάβολον, ",
          "anchor": "HEB.2.14",
          "marks": [],
          "anchors": [
            "HEB.2.14"
          ],
          "sourceAnchor": "HEB.2.14"
        },
        {
          "verse": "15",
          "anchor": "HEB.2.15",
          "anchors": [
            "HEB.2.15"
          ],
          "sourceAnchor": "HEB.2.15"
        },
        {
          "text": " καὶ ἀπαλλάξῃ τούτους,\n  ὅσοι φόβῳ θανάτου διὰ παντὸς τοῦ ζῆν ἔνοχοι ἦσαν δουλείας.\n  ",
          "anchor": "HEB.2.15",
          "marks": [],
          "anchors": [
            "HEB.2.15"
          ],
          "sourceAnchor": "HEB.2.15"
        },
        {
          "verse": "16",
          "anchor": "HEB.2.16",
          "anchors": [
            "HEB.2.16"
          ],
          "sourceAnchor": "HEB.2.16"
        },
        {
          "text": " οὐ γὰρ δήπου ἀγγέλων ἐπιλαμβάνεται,\n  ἀλλὰ ",
          "anchor": "HEB.2.16",
          "marks": [],
          "anchors": [
            "HEB.2.16"
          ],
          "sourceAnchor": "HEB.2.16"
        },
        {
          "text": "σπέρματος Ἀβραὰμ ἐπιλαμβάνεται",
          "anchor": "HEB.2.16",
          "marks": [],
          "anchors": [
            "HEB.2.16"
          ],
          "sourceAnchor": "HEB.2.16"
        },
        {
          "text": ".\n  ",
          "anchor": "HEB.2.16",
          "marks": [],
          "anchors": [
            "HEB.2.16"
          ],
          "sourceAnchor": "HEB.2.16"
        },
        {
          "verse": "17",
          "anchor": "HEB.2.17",
          "anchors": [
            "HEB.2.17"
          ],
          "sourceAnchor": "HEB.2.17"
        },
        {
          "text": " ὅθεν ὤφειλεν κατὰ πάντα τοῖς ἀδελφοῖς\n  ὁμοιωθῆναι, ἵνα ἐλεήμων γένηται καὶ πιστὸς ἀρχιερεὺς τὰ πρὸς τὸν\n  Θεόν, εἰς τὸ ἱλάσκεσθαι τὰς ἁμαρτίας τοῦ λαοῦ. ",
          "anchor": "HEB.2.17",
          "marks": [],
          "anchors": [
            "HEB.2.17"
          ],
          "sourceAnchor": "HEB.2.17"
        },
        {
          "verse": "18",
          "anchor": "HEB.2.18",
          "anchors": [
            "HEB.2.18"
          ],
          "sourceAnchor": "HEB.2.18"
        },
        {
          "text": " ἐν ᾧ γὰρ πέπονθεν αὐτὸς πειρασθείς, δύναται τοῖς\n  πειραζομένοις βοηθῆσαι.",
          "anchor": "HEB.2.18",
          "marks": [],
          "anchors": [
            "HEB.2.18"
          ],
          "sourceAnchor": "HEB.2.18"
        }
      ]
    }
