          "marks": [],
          "anchors": [
            "HEB.2.6"
          ],
          "sourceAnchor": "HEB.2.6"
        },
        {
          "text": "Τί ἐστιν\n  ἄνθρωπος ὅτι μιμνῄσκῃ αὐτοῦ;",
          "anchor": "HEB.2.6",
          "marks": [],
          "anchors": [
            "HEB.2.6"
          ],
          "sourceAnchor": "HEB.2.6"
        }
